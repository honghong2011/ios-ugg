diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -324,6 +324,24 @@
 	for (int shift = 28; shift >= 0; shift -= 4) {
 		sweet_early_putc(digits[(v >> shift) & 0xf]);
 	}
+}
+
+/*
+ * Diagnostic readout for boot paths that need to report several numbers.
+ *
+ * Uses only sweet_early_putc/hex helpers: no varargs, no _doprnt, no system
+ * registers, so it stays safe even where the earlier SP_EL0 read trapped.
+ */
+void
+sweet_early_val(const char *tag, uint64_t value)
+{
+	if (early_disabled) {
+		return;
+	}
+	sweet_early_putc('\n');
+	sweet_early_string(tag);
+	sweet_early_putc(' ');
+	sweet_early_hex64(value);
 }
 
