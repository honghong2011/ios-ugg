 	bl		EXT(set_mmu_ttb)
 	mov		lr, x19
+#if defined(BOARD_UGG)
+	add		x0, x25, #(2 * PGBYTES)
+#else
 	add		x0, x25, PGBYTES
+#endif
 	and		x0, x0, #(TTBR_BADDR_MASK)
 	MSR_TTBR1_EL1_X0
 
@@ -847,6 +991,17 @@ common_start:
