--- /dev/null
+++ b/osfmk/arm64/ugg_early_board.h
@@ -0,0 +1,31 @@
+/*
+ * Early-console panel geometry, per board.
+ *
+ * sweet_early.c draws into the bootloader splash buffer during early kernel
+ * startup, so the address, size and pixel format must be exact for the board.
+ *
+ * ugg (MSM8937/8940, mi8937 family): LK leaves its splash in a reserved 20 MB
+ * region at 0x90000000 that is already relocatable at boot time (the ADT node
+ * is named after the old 0x83000000 address), 720x1280, RGB888, 2160-byte
+ * rows. 24 bpp is the part that bites: a 32-bit store lands on the next pixel
+ * and smears every glyph into diagonal noise.
+ */
+#ifndef _ARM64_UGG_EARLY_BOARD_H_
+#define _ARM64_UGG_EARLY_BOARD_H_
+
+#if defined(BOARD_UGG) || defined(BOARD_UGGLITE)
+#define UGG_EARLY_FB      0x90000000UL
+#define UGG_EARLY_WIDTH   720u
+#define UGG_EARLY_HEIGHT  1280u
+#define UGG_EARLY_STRIDE  2160u
+#define UGG_EARLY_BPP24   1
+#else
+/* Redmi Note 10 Pro (sweet): 1080x2400 a8r8g8b8 at 0x9c000000, 4320-byte rows. */
+#define UGG_EARLY_FB      0x9c000000UL
+#define UGG_EARLY_WIDTH   1080u
+#define UGG_EARLY_HEIGHT  2400u
+#define UGG_EARLY_STRIDE  4320u
+#define UGG_EARLY_BPP24   0
+#endif
+
+#endif /* _ARM64_UGG_EARLY_BOARD_H_ */
