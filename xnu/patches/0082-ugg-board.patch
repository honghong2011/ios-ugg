-	}
-
-	__asm__ volatile ("mrs	%0, CNTKCTL_EL1" : "=r"(cntkctl));
-
-	cntkctl |= (bit_index << CNTKCTL_EL1_EVENTI_SHIFT);
-	cntkctl |= CNTKCTL_EL1_EVNTEN;
-	cntkctl |= CNTKCTL_EL1_EVENTDIR; /* 1->0; why not? */
-
