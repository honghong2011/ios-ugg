+			    (uint64_t)done * nodeSize / blockSize;
+			if (ufs_read_blocks(su.first_block + firstblk, chunk * nodeSize / blockSize)) {
+				printf("UGG CHECK: read failed at node %u\n", node + done);
+				return;
+			}
+			for (uint32_t k = 0; k < chunk; k++) {
+				const uint8_t *n = bounce + (uint64_t)k * nodeSize;
+				uint32_t fLink = (uint32_t)n[0] << 24 | (uint32_t)n[1] << 16 |
