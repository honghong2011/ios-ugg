+	for (unsigned r = 0; r < sizeof(regions) / sizeof(regions[0]); r++) {
+		uint64_t first = regions[r][0];
+		uint32_t count = (uint32_t)regions[r][1];
+		uint32_t bytes = count * UFS_BLOCK;
