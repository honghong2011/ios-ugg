+	static const uint64_t regions[][2] = {
+		{ 0, 64 },              /* volume header / allocation blocks */
+		{ 1734912, 256 },       /* image block of catalog node 19174 (2 MiB) */
+		{ 1735170, 256 },       /* second half of the same extent */
+		{ 800000, 256 },        /* arbitrary middle-of-partition slab */
+	};
