+				if (known) {
+					printf("UGG CHECK: node=%u fLink=0x%08x bLink=0x%08x kind=0x%02x%s\n",
+					    idx, fLink, bLink, kind,
+					    (fLink >= totalNodes || bLink >= totalNodes) ? "  <-- INVALID" : "");
+				}
+				if (fLink >= totalNodes || bLink >= totalNodes ||
+				    (kind != 0 && kind != 1 && kind != 2 && kind != 0xff)) {
+					bad++;
