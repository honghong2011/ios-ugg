+		if (bytes > BOUNCE_SIZE) {
+			printf("UGG XCHECK: r%u region too large\n", r);
+			continue;
+		}
+		ugg_no_multiblock = 0;
+		if (ufs_read_blocks(su.first_block + first, count)) {
+			printf("UGG XCHECK: r%u multi-block read failed\n", r);
+			continue;
+		}
+		memcpy(b, a, bytes);
