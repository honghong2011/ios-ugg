+#if defined(UGG_CPU_ARMV8_0)
+static uint64_t ugg_lse_count;
+static struct { int pid; uint32_t n; char name[17]; } ugg_lse_top[8];
+extern char *proc_name_address(void *p);
+
+static void
+ugg_lse_account(void)
+{
+	int pid = task_pid(current_task());
+	unsigned slot = 0, min = 0;
+	for (slot = 0; slot < 8; slot++) {
+		if (ugg_lse_top[slot].pid == pid && ugg_lse_top[slot].n) {
+			ugg_lse_top[slot].n++;
+			return;
+		}
+		if (ugg_lse_top[slot].n < ugg_lse_top[min].n) {
+			min = slot;
+		}
+	}
+	if (ugg_lse_top[min].n > 1) {
+		ugg_lse_top[min].n--;                   /* decay: keep the hot ones */
+		return;
+	}
+	void *p = get_bsdtask_info(current_task());
+	const char *nm = p ? proc_name_address(p) : "?";
+	ugg_lse_top[min].pid = pid;
+	ugg_lse_top[min].n = 1;
+	strlcpy(ugg_lse_top[min].name, nm ? nm : "?", sizeof(ugg_lse_top[min].name));
+}
+
+/* Called once a minute from the startup.c heartbeat. */
+void ugg_lse_report(void);
+void
+ugg_lse_report(void)
+{
+	static uint64_t last;
+	uint64_t now = ugg_lse_count;
+	printf("UGG LSE: %llu emulated (+%llu in the last minute)", now, now - last);
+	for (int r = 0; r < 3; r++) {
+		int best = -1;
+		for (int i = 0; i < 8; i++) {
+			if (ugg_lse_top[i].n && (best < 0 || ugg_lse_top[i].n > ugg_lse_top[best].n)) {
+				best = i;
+			}
+		}
+		if (best < 0) {
+			break;
+		}
+		printf(" %s[%d]:%u", ugg_lse_top[best].name, ugg_lse_top[best].pid, ugg_lse_top[best].n);
+		ugg_lse_top[best].n = 0;
+	}
+	printf("\n");
+	bzero(ugg_lse_top, sizeof(ugg_lse_top));
+	last = now;
+}
+
+static inline uint64_t
+ugg_ureg(arm_saved_state_t *s, unsigned r)
+{
+	return r == 31 ? 0 : (uint64_t)get_saved_state_reg(s, r);
+}
+
+static inline void
+ugg_set_ureg(arm_saved_state_t *s, unsigned r, uint64_t v)
+{
+	if (r != 31) {
+		set_saved_state_reg(s, r, (register_t)v);
+	}
+}
+
+static inline bool
+ugg_user_writable(uint64_t va)
+{
+	uint64_t par;
+	__asm__ volatile ("at s1e0w, %1\n\tisb\n\tmrs %0, par_el1" : "=r"(par) : "r"(va) : "memory");
+	return (par & 1) == 0;
+}
+
+static inline uint64_t
+ugg_ld(uint64_t va, unsigned sz)
+{
+	switch (sz) {
+	case 0: return *(volatile uint8_t *)va;
+	case 1: return *(volatile uint16_t *)va;
+	case 2: return *(volatile uint32_t *)va;
+	default: return *(volatile uint64_t *)va;
+	}
+}
+
+static inline void
+ugg_st(uint64_t va, unsigned sz, uint64_t v)
+{
+	switch (sz) {
+	case 0: *(volatile uint8_t *)va = (uint8_t)v; break;
+	case 1: *(volatile uint16_t *)va = (uint16_t)v; break;
+	case 2: *(volatile uint32_t *)va = (uint32_t)v; break;
+	default: *(volatile uint64_t *)va = v; break;
+	}
+}
+
+static inline uint64_t
+ugg_trunc(uint64_t v, unsigned sz)
+{
+	return sz == 3 ? v : v & ((1ULL << (8u << sz)) - 1);
+}
+
+static inline int64_t
+ugg_sext(uint64_t v, unsigned sz)
+{
+	unsigned sh = 64 - (8u << sz);
+	return (int64_t)(v << sh) >> sh;
+}
+
+/* Returns true if insn was an LSE atomic and has been emulated (PC advanced). */
+static bool
+ugg_emulate_lse(arm_saved_state_t *state, uint32_t insn)
+{
+	unsigned kind, sz, op = 0, bytes;
+	unsigned rs = (insn >> 16) & 31, rn = (insn >> 5) & 31, rt = insn & 31;
+
+	if ((insn & 0x3F200C00) == 0x38200000) {               /* LD<op>, SWP */
+		unsigned o3 = (insn >> 15) & 1, opc = (insn >> 12) & 7;
+		if (o3 && opc != 0) {
+			return false;                           /* LDAPR (v8.3) and reserved */
+		}
+		kind = 0; sz = insn >> 30; op = o3 ? 8 : opc; bytes = 1u << sz;
+	} else if ((insn & 0x3FA07C00) == 0x08A07C00) {        /* CAS{A,L,AL}{B,H,} */
+		kind = 1; sz = insn >> 30; bytes = 1u << sz;
+	} else if ((insn & 0xBFA07C00) == 0x08207C00) {        /* CASP{A,L,AL} */
+		if ((rs & 1) || (rt & 1)) {
+			return false;
+		}
+		kind = 2; sz = 2 + ((insn >> 30) & 1); bytes = 2u << sz;
+	} else {
+		return false;
+	}
+
+	uint64_t va = rn == 31 ? (uint64_t)get_saved_state_sp(state) : (uint64_t)get_saved_state_reg(state, rn);
+	va = tbi_clear(va);
+	vm_map_t map = current_map();
+	if ((va & (bytes - 1)) || va < vm_map_min(map) || va + bytes > vm_map_max(map)) {
+		return false;
+	}
+
+	for (int tries = 0; tries < 8; tries++) {
+		boolean_t istate = ml_set_interrupts_enabled(FALSE);
+		if (ugg_user_writable(va)) {
+			uint64_t a = ugg_ureg(state, rs), old, nv = 0;
+			__builtin_arm_dmb(0xb);
+			if (kind == 0) {
+				old = ugg_ld(va, sz);
+				switch (op) {
+				case 0: nv = old + a; break;
+				case 1: nv = old & ~a; break;
+				case 2: nv = old ^ a; break;
+				case 3: nv = old | a; break;
+				case 4: nv = ugg_sext(old, sz) > ugg_sext(a, sz) ? old : a; break;
+				case 5: nv = ugg_sext(old, sz) < ugg_sext(a, sz) ? old : a; break;
+				case 6: nv = old > ugg_trunc(a, sz) ? old : a; break;
+				case 7: nv = old < ugg_trunc(a, sz) ? old : a; break;
+				default: nv = a; break;                 /* SWP */
+				}
+				ugg_st(va, sz, nv);
+				ugg_set_ureg(state, rt, old);
+			} else if (kind == 1) {
+				old = ugg_ld(va, sz);
+				if (old == ugg_trunc(a, sz)) {
+					ugg_st(va, sz, ugg_ureg(state, rt));
+				}
+				ugg_set_ureg(state, rs, old);
