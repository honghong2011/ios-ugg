+		uint64_t x = type | MPIDR_CPU_ID(cpu_mpidr);
+		MSR("S3_5_C15_C0_0", x);
+	} else {
+		#define IPI_RR_TARGET_CLUSTER_SHIFT 16
+		uint64_t x = type | (MPIDR_CLUSTER_ID(cpu_mpidr) << IPI_RR_TARGET_CLUSTER_SHIFT) | MPIDR_CPU_ID(cpu_mpidr);
+		MSR("S3_5_C15_C0_1", x);
+	}
+#else
+	uint64_t x = type | MPIDR_CPU_ID(cpu_mpidr);
+	MSR("S3_5_C15_C0_1", x);
+#endif
