+/* osfmk/kern/thread.h, not exported to the BSD layer */
+extern kern_return_t kernel_thread_start_priority(thread_continue_t, void *, integer_t, thread_t *);
+extern void sweet_hid_key(int key, int down);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+void ugg_input_init(void);
+
+#define QUP_PA          0x078b7000u
+#define TLMM_PA(n)      (0x01000000u + 0x1000u * (n))
+#define SPMI_CORE_PA    0x0200f000u
+#define SPMI_OBS_PA     0x02c00000u
+
+#define Q_CONFIG        0x000
+#define Q_STATE         0x004
+#define Q_IO_MODE       0x008
+#define Q_SW_RESET      0x00c
+#define Q_OPER          0x018
+#define Q_MX_OUT_CNT    0x100
+#define Q_OUT_FIFO      0x110
+#define Q_MX_WR_CNT     0x150
+#define Q_MX_IN_CNT     0x200
+#define Q_MX_RD_CNT     0x208
+#define Q_IN_FIFO       0x218
+#define Q_I2C_CLK       0x400
+#define Q_I2C_STATUS    0x404
+#define ST_VALID        (1u << 2)
+#define OP_OUT_NOT_EMPTY (1u << 4)
+#define OP_IN_NOT_EMPTY (1u << 5)
+#define I2C_ERR_MASK    0x38000fcu
+#define T_START         (1u << 8)
+#define T_STOP          (3u << 8)
+#define T_REC           (4u << 8)
+
+/* Goodix GT9xx on the BLSP1 QUP3 bus (the DT node is goodix@5d). */
+#define GT_ADDR         0x5d
+#define GT_REG_CONFIG   0x8047      /* 186-byte config block */
+#define GT_REG_PRODUCT  0x8140      /* 4 ASCII characters, e.g. "9111" */
+#define GT_REG_STATUS   0x814e      /* bit7 = buffer ready, bits[3:0] = points */
+#define GT_REG_POINT0   0x814f      /* 8 bytes per point */
+
+#define GT_POINTS       5           /* 1 + 8*5 = 41 bytes, one QUP FIFO pass */
+#define GT_FALLBACK_MAX_X 1200      /* goodix,display-coords */
+#define GT_FALLBACK_MAX_Y 1920
+
+#define PANEL_W         720
+#define PANEL_H         1280
+
+static vm_offset_t qup, gpio65, gpio85, spmi_core, spmi_obs;
+static int pon_chan = -1;
+static bool input_started;
+static int input_chan;
+static int gt_max_x = GT_FALLBACK_MAX_X, gt_max_y = GT_FALLBACK_MAX_Y;
+static int gt_swap_xy = -1;         /* -1 = decide once the maxima are known */
+
+static inline uint32_t rd(vm_offset_t b, uint32_t o) { return *(volatile uint32_t *)(b + o); }
+static inline void wr(vm_offset_t b, uint32_t o, uint32_t v) { *(volatile uint32_t *)(b + o) = v; }
+
+static uint64_t
+deadline_us(uint64_t us)
+{
+	uint64_t d;
+	nanoseconds_to_absolutetime(us * NSEC_PER_USEC, &d);
+	return mach_absolute_time() + d;
+}
+
+/* ---------------- QUP I2C (polled FIFO mode) ---------------- */
+
+static int
+qup_state(uint32_t s)
+{
+	uint64_t end = deadline_us(10000);
+	while (mach_absolute_time() < end) {
+		uint32_t v = rd(qup, Q_STATE);
+		if ((v & ST_VALID) && (v & 3) == s) {
+			return 0;
+		}
+		if (v & ST_VALID) {
+			wr(qup, Q_STATE, s);
+		}
+	}
+	return -1;
+}
+
+static int
+qup_xfer(const uint16_t *tags, int ntags, uint8_t *in, int nread)
+{
+	wr(qup, Q_SW_RESET, 1);
+	uint64_t end = deadline_us(10000);
+	while (!(rd(qup, Q_STATE) & ST_VALID) && mach_absolute_time() < end) {
+	}
+	if (qup_state(0)) {
+		return -10;
+	}
+	wr(qup, Q_I2C_CLK, (3u << 8) | 21u);                       /* 400 kHz from 19.2 MHz */
+	wr(qup, Q_MX_OUT_CNT, 0);
+	wr(qup, Q_MX_WR_CNT, (uint32_t)ntags);
+	wr(qup, Q_MX_IN_CNT, 0);
+	wr(qup, Q_MX_RD_CNT, (uint32_t)nread);
+	wr(qup, Q_CONFIG, (2u << 8) | 15u | (nread ? 0 : (1u << 7)));
+	wr(qup, Q_IO_MODE, (1u << 14) | (1u << 15));
+	wr(qup, Q_OPER, 0xff0);
+	wr(qup, Q_I2C_STATUS, 0xfffffc);
+	if (qup_state(1)) {
+		return -11;
+	}
+	for (int i = 0; i < ntags; i += 2) {
+		wr(qup, Q_OUT_FIFO, tags[i] | (i + 1 < ntags ? (uint32_t)tags[i + 1] << 16 : 0));
+	}
+	int got = 0;
+	end = deadline_us(20000);
+	while (mach_absolute_time() < end) {
+		uint32_t st = rd(qup, Q_I2C_STATUS), op = rd(qup, Q_OPER);
+		if (st & I2C_ERR_MASK) {
+			qup_state(0);
+			return -3;
+		}
+		while (got < nread && (op & OP_IN_NOT_EMPTY)) {
+			uint32_t v = rd(qup, Q_IN_FIFO);
+			in[got++] = (uint8_t)v;
+			if (got < nread) {
+				in[got++] = (uint8_t)(v >> 16);
+			}
+			op = rd(qup, Q_OPER);
+		}
+		if (got >= nread && !(op & OP_OUT_NOT_EMPTY) && !(st & (1u << 8))) {
+			break;
+		}
+	}
+	qup_state(0);
+	return got < nread ? -4 : 0;
+}
+
+/*
+ * GT9xx register read. Unlike the FT5435 (8-bit register address), GT9xx uses
+ * a 16-bit big-endian register address. The chip keeps its register pointer
+ * across a STOP, so this is two transfers: point at the register, then read
+ * from the pointer with a fresh start.
+ */
+static int
+gt_read(uint16_t reg, uint8_t *buf, int n)
+{
+	uint16_t w[3] = {
+		(uint16_t)(T_START | (GT_ADDR << 1)),
+		(uint16_t)(reg >> 8),
+		(uint16_t)(T_STOP | (reg & 0xff)),
+	};
+	int e = qup_xfer(w, 3, 0, 0);
+	if (e) {
+		return e;
+	}
+	uint16_t r[2] = {
+		(uint16_t)(T_START | (GT_ADDR << 1) | 1),
+		(uint16_t)(T_REC | (unsigned)n),
+	};
+	return qup_xfer(r, 2, buf, n);
+}
+
+/*
+ * GT9xx register write: address phase then data, all in one FIFO transfer.
+ * The last data byte carries T_STOP so the controller generates the STOP.
+ */
+static int
+gt_write(uint16_t reg, const uint8_t *buf, int n)
+{
+	uint16_t w[4];
+	w[0] = (uint16_t)(T_START | (GT_ADDR << 1));
+	w[1] = (uint16_t)(reg >> 8);
+	w[2] = n > 0 ? (uint16_t)(reg & 0xff) : (uint16_t)(T_STOP | (reg & 0xff));
+	if (n <= 0) {
+		return qup_xfer(w, 3, 0, 0);
+	}
+	w[3] = (uint16_t)(T_STOP | buf[0]);
+	int e = qup_xfer(w, 4, 0, 0);
+	for (int i = 1; i < n; i++) {
+		uint16_t m[1] = { (uint16_t)(i + 1 == n ? (T_STOP | buf[i]) : buf[i]) };
+		e = qup_xfer(m, 1, 0, 0);
+		if (e) {
+			return e;
+		}
+	}
+	return e;
+}
+/* ---------------- SPMI observer read (PON) ---------------- */
+
+static bool
+pon_rt(uint8_t *val)
+{
+	if (pon_chan < 0 || !spmi_obs) {
+		return false;
+	}
+	wr(spmi_obs, 0x00, (1u << 27) | (0x10u << 4));            /* EXT_READL, 1 byte, reg 0x10 */
+	uint64_t end = deadline_us(1000);
+	uint32_t st = 0;
+	while (!(st = rd(spmi_obs, 0x08)) && mach_absolute_time() < end) {
+	}
+	if (st != 1) {
+		return false;
+	}
+	*val = (uint8_t)rd(spmi_obs, 0x18);
+	return true;
+}
+
+/* ---------------- GT9xx helpers ---------------- */
+
+/*
+ * Read the config block's resolution fields (0x8048 = max_x, 0x804a = max_y)
+ * so the panel->display mapping is measured, not assumed. Called once from
+ * the poller and only affects scaling.
+ */
+static void
+gt_read_resolution(void)
+{
+	uint8_t b[4];
+	if (gt_read(GT_REG_CONFIG + 1, b, sizeof(b)) == 0) {
+		unsigned mx = (unsigned)b[0] | ((unsigned)b[1] << 8);
+		unsigned my = (unsigned)b[2] | ((unsigned)b[3] << 8);
+		if (mx >= 64 && my >= 64 && mx <= 8192 && my <= 8192) {
+			gt_max_x = (int)mx;
+			gt_max_y = (int)my;
+		}
+	}
+	/* The DT's display-coords are the fallback if the config read failed. */
+	int swap = 0;
+	if (PE_parse_boot_argn("uggtouchswap", &swap, sizeof(swap)) && swap) {
+		gt_swap_xy = 1;
+	} else if (gt_swap_xy < 0) {
+		/* A panel taller than wide must report max_y as the long axis. */
+		gt_swap_xy = (gt_max_y >= gt_max_x) ? 0 : 1;
+	}
+}
+
+static int
+gt_scale_x(int raw)
+{
+	int span = gt_swap_xy ? gt_max_y : gt_max_x;
+	if (span <= 0) {
+		return 0;
+	}
+	int v = (int)(((int64_t)raw * PANEL_W) / span);
+	return v < 0 ? 0 : (v > PANEL_W - 1 ? PANEL_W - 1 : v);
+}
+
+static int
+gt_scale_y(int raw)
+{
+	int span = gt_swap_xy ? gt_max_x : gt_max_y;
+	if (span <= 0) {
+		return 0;
+	}
+	int v = (int)(((int64_t)raw * PANEL_H) / span);
+	return v < 0 ? 0 : (v > PANEL_H - 1 ? PANEL_H - 1 : v);
+}
+
+/* ---------------- poller ---------------- */
+
+static void
+input_wait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&input_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+input_thread(void *arg __unused, wait_result_t wr_ __unused)
+{
+	int key_state[3] = {0, 0, 0};
+	bool fdown[GT_POINTS] = {false};
+	int fx[GT_POINTS] = {0}, fy[GT_POINTS] = {0};
+	unsigned logged = 0, errors = 0, reads = 0;
+
+	gt_read_resolution();
+	printf("UGG INPUT: GT9xx max %dx%d, swap %d\n", gt_max_x, gt_max_y, gt_swap_xy);
+
+	for (;;) {
+		/* keys */
+		uint8_t pon = 0;
+		bool pok = pon_rt(&pon);
+		int now[3] = {
+			pok ? !!(pon & 1u) : key_state[0],
+			!(rd(gpio85, 4) & 1u),
+			pok ? !!(pon & 2u) : key_state[2],
+		};
+		for (int k = 0; k < 3; k++) {
+			if (now[k] != key_state[k]) {
+				key_state[k] = now[k];
+				printf("UGG INPUT: key %d %s\n", k, now[k] ? "down" : "up");
+				sweet_hid_key(k, now[k]);
+			}
+		}
+
+		/* touch: poll while the IRQ line is low or a finger is still down */
+		bool irq = !(rd(gpio65, 4) & 1u);
+		bool any = false;
+		for (int i = 0; i < GT_POINTS; i++) {
+			any |= fdown[i];
+		}
+		if (irq || any) {
+			uint8_t st = 0;
+			int e = gt_read(GT_REG_STATUS, &st, 1);
+			if (e) {
+				if ((errors++ % 500) == 0) {
+					printf("UGG INPUT: touch status read error %d\n", e);
+				}
+			} else if (st & 0x80) {
+				/* Buffer ready: read every point the chip latched. */
+				unsigned n = st & 0x0f;
+				uint8_t b[8 * GT_POINTS];
+				if (n > GT_POINTS) {
+					n = GT_POINTS;
+				}
+				e = n ? gt_read(GT_REG_POINT0, b, (int)(8 * n)) : 0;
+				/* Always acknowledge, even when the read failed. */
+				uint8_t zero = 0;
+				(void)gt_write(GT_REG_STATUS, &zero, 1);
+				if (e == 0) {
+					bool seen[GT_POINTS] = {false};
+					for (unsigned t = 0; t < n; t++) {
+						const uint8_t *p = b + 8 * t;
+						unsigned id = p[0] & 0x0f;
+						int rx = (int)((unsigned)p[1] | ((unsigned)p[2] << 8));
+						int ry = (int)((unsigned)p[3] | ((unsigned)p[4] << 8));
+						if (id >= GT_POINTS) {
+							continue;
+						}
+						int x = gt_scale_x(gt_swap_xy ? ry : rx);
+						int y = gt_scale_y(gt_swap_xy ? rx : ry);
+						seen[id] = true;
+						if (!fdown[id] || x != fx[id] || y != fy[id]) {
+							sweet_hid_touch((int)id, 1, x, y);
+							if (logged < 8) {
+								logged++;
+								printf("UGG INPUT: touch %u raw %d,%d -> %d,%d\n",
+								    id, rx, ry, x, y);
+							}
+						}
+						fdown[id] = true;
+						fx[id] = x;
+						fy[id] = y;
+					}
+					for (int i = 0; i < GT_POINTS; i++) {
+						if (fdown[i] && !seen[i]) {
+							sweet_hid_touch(i, 0, fx[i], fy[i]);
+							fdown[i] = false;
+						}
+					}
+				}
+				if ((reads++ % 60000) == 0) {
+					printf("UGG INPUT: %u reports, %u errors\n", reads, errors);
+				}
+			} else {
+				/* Not ready: nothing latched, so nothing to acknowledge. */
+				reads++;
+			}
+		}
+		any = false;
+		for (int i = 0; i < GT_POINTS; i++) {
+			any |= fdown[i];
+		}
+		input_wait(any ? 8 : 15);
+	}
+}
+
+void
+ugg_input_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+
+	if (input_started) {
+		return;
+	}
+	input_started = true;
+	PE_parse_boot_argn("ugginput", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("UGG INPUT: disabled (ugginput=0)\n");
+		return;
+	}
+	qup = ml_io_map(QUP_PA, 0x1000);
+	gpio65 = ml_io_map(TLMM_PA(65), 0x1000);
+	gpio85 = ml_io_map(TLMM_PA(85), 0x1000);
+	spmi_core = ml_io_map(SPMI_CORE_PA, 0x1000);
+	if (!qup || !gpio65 || !gpio85 || !spmi_core) {
+		printf("UGG INPUT: MMIO mapping failed\n");
+		return;
+	}
+	for (int i = 0; i < 512; i++) {
+		if (((rd(spmi_core, 0x800 + 4u * (uint32_t)i) >> 8) & 0xfff) == 0x008) {
+			pon_chan = i;
+			break;
+		}
+	}
+	if (pon_chan >= 0) {
+		spmi_obs = ml_io_map(SPMI_OBS_PA + 0x8000u * (uint32_t)pon_chan, 0x1000);
+	}
+	uint8_t pid[4] = {0};
+	int e = gt_read(GT_REG_PRODUCT, pid, 4);
+	printf("UGG INPUT: GT9xx product \"%c%c%c%c\" (err %d), PON chan %d, vol+ gpio85=%u\n",
+	    pid[0] ? pid[0] : '?', pid[1] ? pid[1] : '?', pid[2] ? pid[2] : '?',
+	    pid[3] ? pid[3] : '?', e, pon_chan, rd(gpio85, 4) & 1u);
+	/* Above user threads: a starved poller would add its own delay to every touch. */
+	if (kernel_thread_start_priority(input_thread, 0, 81, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* UGG_BOARD */
