+	static uint8_t snap[BOUNCE_SIZE] __attribute__((aligned(64)));
+	uint8_t *a = (uint8_t *)(su.dma + DMA_BOUNCE);   /* the live bounce buffer */
+	uint8_t *b = snap;                               /* the multi-block copy */
