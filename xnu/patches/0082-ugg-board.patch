+#if defined(UGG_BOARD)
+/*
+ * UGG: eMMC on SDHCI-MSM SDHC1 (vendor core 0x07824000, SDHCI at +0x900).
+ * The ugg shim re-identified the card (CMD0..CMD7, RCA 2) and left it in
+ * the transfer state at 25 MHz, 1-bit bus, sector addressing. Polled PIO
+ * through the buffer data port; CMD18/CMD25 with auto-CMD12 for multi-block.
+ */
+#define UGG_SDHC_PAGE  0x07824000UL
+#define UGG_HC         0x900u
+#define M_BLK           0x04
+#define M_ARG           0x08
+#define M_XFER          0x0c
+#define M_RESP0         0x10
+#define M_BUF           0x20
+#define M_PRES          0x24
+#define M_CLK           0x2c
+#define M_STS           0x30
+#define MS_CMD_DONE     (1u << 0)
+#define MS_XFER_DONE    (1u << 1)
+#define MS_ERR          (1u << 15)
+#define MP_WR_EN        (1u << 10)
+#define MP_RD_EN        (1u << 11)
+#define MR_NONE         0x00u
+#define MR_R1           0x1au
+#define MR_R1B          0x1bu
+#define UGG_RCA        2u
+#define UGG_SECT       512u
+#define UGG_SPB        (UFS_BLOCK / UGG_SECT)  /* sectors per driver block */
+#define UGG_CHUNK      256u                     /* sectors per command */
+
+static uint32_t ugg_resp;
+
+/*
+ * UGG: one single-block command (CMD17/CMD24) per sector. DEFAULT ON.
+ *
+ * ugg/shim/sdhc.c has read this eMMC successfully for weeks and does it
+ * entirely with CMD17, one sector per command. This driver preferred
+ * CMD18/CMD25 with auto-CMD12 for anything longer than a sector, and that is
+ * the only transfer shape the shim never exercises.
+ *
+ * The HFS failure points straight at it: a freshly flashed image that
+ * tools/check-hfs-root.py certifies as undamaged reaches /sbin/launchd and
+ * dies with errno 5 on catalog nodes 19174..19514 -- all inside the last
+ * catalog extent, in one contiguous run, with good nodes on both sides. A
+ * read-only mount reproduces the same values bit for bit, so nothing we write
+ * is at fault: the bytes coming back from the card are wrong.
+ *
+ * Single-sector transfers are slower but they are the shape that is known to
+ * work here. Boot-arg uggnomb=0 restores multi-block for benchmarking.
+ */
+static int ugg_no_multiblock = 1;
+
+static inline uint32_t
+mh_rd(uint32_t o)
+{
+	return *(volatile uint32_t *)(su.regs + UGG_HC + o);
+}
+
+static inline void
+mh_wr(uint32_t o, uint32_t v)
+{
+	*(volatile uint32_t *)(su.regs + UGG_HC + o) = v;
+}
+
+static uint64_t
+ugg_deadline(uint64_t ms)
+{
+	uint64_t d;
+	nanoseconds_to_absolutetime(ms * NSEC_PER_MSEC, &d);
+	return mach_absolute_time() + d;
+}
+
+static void
+ugg_reset_lines(void)
+{
+	mh_wr(M_CLK, mh_rd(M_CLK) | (0x06u << 24));      /* reset CMD + DAT */
+	uint64_t end = ugg_deadline(100);
+	while (((mh_rd(M_CLK) >> 24) & 0x06) && mach_absolute_time() < end) {
+	}
+	mh_wr(M_STS, 0xffffffff);
+}
+
+/* Wait for a status bit (or error); 0 on timeout. */
+static uint32_t
+ugg_wait_sts(uint32_t mask, uint64_t ms)
+{
+	uint64_t end = ugg_deadline(ms);
+	do {
+		uint32_t s = mh_rd(M_STS);
+		if (s & (mask | MS_ERR)) {
+			return s;
+		}
+	} while (mach_absolute_time() < end);
+	/* Preempted past the deadline (run #25: CPU-starved)? Look once more. */
+	uint32_t s = mh_rd(M_STS);
+	return (s & (mask | MS_ERR)) ? s : 0;
+}
+
+/* One command, nblk 512-byte sectors of PIO data through buf. dir: 0, -1 read, 1 write. */
+static int
+ugg_cmd(uint32_t idx, uint32_t arg, uint32_t rsp, int dir, uint32_t nblk, uint32_t *buf)
+{
+	uint64_t end = ugg_deadline(1000);
+	while (mh_rd(M_PRES) & ((dir || rsp == MR_R1B) ? 3u : 1u)) {
+		if (mach_absolute_time() > end) {
+			printf("UGG EMMC: CMD%u: lines busy (pres 0x%x)\n", idx, mh_rd(M_PRES));
+			ugg_reset_lines();
+			return EBUSY;
+		}
+	}
+	mh_wr(M_STS, 0xffffffff);
+	uint32_t xfer = 0, c = (idx << 8) | rsp;
+	if (dir) {
+		mh_wr(M_BLK, (nblk << 16) | UGG_SECT);
+		xfer = (1u << 1) | (dir < 0 ? (1u << 4) : 0);   /* block count enable, read */
+		if (nblk > 1) {
+			xfer |= (1u << 5) | (1u << 2);           /* multi-block, auto-CMD12 */
+		}
+		c |= 0x20;                                       /* data present */
+	}
+	mh_wr(M_ARG, arg);
+	mh_wr(M_XFER, (c << 16) | xfer);
+
+	uint32_t s = ugg_wait_sts(MS_CMD_DONE, 1000);
+	if (!s || (s & MS_ERR)) {
+		printf("UGG EMMC: CMD%u arg 0x%x: %s (sts 0x%08x)\n", idx, arg,
+		    s ? "error" : "timeout", s);
+		ugg_reset_lines();
+		return s ? EIO : ETIMEDOUT;
+	}
+	ugg_resp = mh_rd(M_RESP0);
+	mh_wr(M_STS, MS_CMD_DONE);
+
+	for (uint32_t b = 0; dir && b < nblk; b++) {
+		uint32_t ready = dir < 0 ? MP_RD_EN : MP_WR_EN;
+		uint64_t bend = ugg_deadline(3000);
+		for (;;) {
+			s = mh_rd(M_STS);
+			if (s & MS_ERR) {
+				break;
+			}
+			if (mh_rd(M_PRES) & ready) {
+				break;
+			}
+			if (mach_absolute_time() > bend) {
+				/* run #25: "data timeout (sts 0x00008000)" with no hardware error
+				 * bits = this deadline passing while preempted. Re-check first. */
+				s = (mh_rd(M_PRES) & ready) ? 0 : MS_ERR;
+				break;
+			}
+		}
+		if (s & MS_ERR) {
+			printf("UGG EMMC: CMD%u block %u/%u: data %s (sts 0x%08x)\n", idx, b, nblk,
+			    (s >> 16) ? "error" : "timeout", s);
+			ugg_reset_lines();
+			return EIO;
+		}
+		mh_wr(M_STS, (1u << 4) | (1u << 5));             /* buffer read/write ready */
+		uint32_t *p = buf + b * (UGG_SECT / 4);
+		if (dir < 0) {
+			/*
+			 * UGG: invalidate before and after writing the FIFO data.
+			 *
+			 * This is PIO: the CPU stores the sector into p[] itself, so the
+			 * bytes land in the D-cache, not in memory. Everything upstream
+			 * (strategy()'s memcpy into the buf cache, the HFS node parser)
+			 * reads that buffer through normal cached loads. If the line was
+			 * evicted in between, those loads see whatever the memory still
+			 * held -- and su.dma is a permanent 1 MiB buffer reused for every
+			 * transfer, so the leftovers are the kernel's own code and data.
+			 *
+			 * That is exactly the symptom: the catalog nodes on the device are
+			 * fine (check-hfs-root.py certifies them) but the kernel parses
+			 * "std::vector" and "#if" out of the buffer. Clean+invalidate
+			 * around the loop so memory and cache agree.
+			 */
+			flush_dcache64((addr64_t)(su.dma_pa + DMA_BOUNCE +
+			    (uint64_t)b * UGG_SECT), UGG_SECT, TRUE);
+			for (unsigned i = 0; i < UGG_SECT / 4; i++) {
+				p[i] = mh_rd(M_BUF);
+			}
+			clean_dcache64((addr64_t)(su.dma_pa + DMA_BOUNCE +
+			    (uint64_t)b * UGG_SECT), UGG_SECT, TRUE);
+		} else {
+			clean_dcache64((addr64_t)(su.dma_pa + DMA_BOUNCE +
+			    (uint64_t)b * UGG_SECT), UGG_SECT, TRUE);
+			for (unsigned i = 0; i < UGG_SECT / 4; i++) {
+				mh_wr(M_BUF, p[i]);
+			}
+		}
+	}
+	if (dir || rsp == MR_R1B) {
+		s = ugg_wait_sts(MS_XFER_DONE, 5000);
+		if (!s || (s & MS_ERR)) {
+			printf("UGG EMMC: CMD%u: transfer %s (sts 0x%08x)\n", idx,
+			    s ? "error" : "timeout", s);
+			ugg_reset_lines();
+			return s ? EIO : ETIMEDOUT;
+		}
+	}
+	mh_wr(M_STS, 0xffffffff);
+	return 0;
+}
+
+/* CMD13 until the card is in transfer state and ready for data. */
+static int
+ugg_card_ready(uint64_t ms)
+{
+	uint64_t end = ugg_deadline(ms);
+	do {
+		int e = ugg_cmd(13, UGG_RCA << 16, MR_R1, 0, 0, NULL);
+		if (e) {
+			return e;
+		}
+		if (((ugg_resp >> 9) & 0xf) == 4 && (ugg_resp & (1u << 8))) {
+			return 0;
+		}
+	} while (mach_absolute_time() < end);
+	printf("UGG EMMC: card not ready (status 0x%x)\n", ugg_resp);
+	return ETIMEDOUT;
+}
+
+/*
+ * After a failed command: reset the CMD/DAT lines, stop an open multi-block
+ * transfer (auto-CMD12 may not have gone out after a data error) and wait
+ * for the card to return to the transfer state.
+ */
+static int
+ugg_recover(void)
+{
+	ugg_reset_lines();
+	if (ugg_cmd(13, UGG_RCA << 16, MR_R1, 0, 0, NULL) == 0) {
+		uint32_t st = (ugg_resp >> 9) & 0xf;
+		if (st == 5 || st == 6) {                        /* data / rcv */
+			(void)ugg_cmd(12, 0, MR_R1B, 0, 0, NULL);
+		}
+	}
+	return ugg_card_ready(5000);
+}
+
+/*
+ * nsec sectors at sector into / from the bounce buffer. A failed chunk is
+ * retried after recovery (reads and writes of the same data are idempotent).
+ * Build #17: a CMD25 failed with SDHCI data timeout (sts 0x00108002) while the
+ * card was busy programming, which cost an HFS journal transaction.
+ */
+static int
+ugg_xfer(uint64_t sector, uint32_t nsec, bool write)
+{
+	uint32_t *buf = (uint32_t *)(su.dma + DMA_BOUNCE);
+	if (nsec > BOUNCE_SIZE / UGG_SECT || sector + nsec > (1ULL << 32)) {
+		return EINVAL;
+	}
+	/*
+	 * The bounce buffer is reused for every transfer and is written by the
+	 * CPU (PIO) on a read. Make sure no stale line from a previous transfer
+	 * can be observed by the code that copies it out, and that nothing still
+	 * sitting in the cache shadows what the card is about to deliver.
+	 */
+	if (!write) {
+		flush_dcache64((addr64_t)(su.dma_pa + DMA_BOUNCE),
+		    BOUNCE_SIZE, TRUE);
+	}
+
+	for (uint32_t done = 0; done < nsec;) {
+		uint32_t n = ugg_no_multiblock ? 1u : MIN(nsec - done, UGG_CHUNK);
+		uint32_t idx = write ? (n > 1 ? 25 : 24) : (n > 1 ? 18 : 17);
+		int e = 0;
+		for (int attempt = 0; attempt < 4; attempt++) {
+			e = ugg_cmd(idx, (uint32_t)(sector + done), MR_R1, write ? 1 : -1, n,
+			    buf + done * (UGG_SECT / 4));
+			if (!e && write) {
+				e = ugg_card_ready(5000);
+			}
+			if (!e) {
+				if (attempt) {
+					printf("UGG EMMC: CMD%u at 0x%llx x%u ok on retry %d\n", idx,
+					    sector + done, n, attempt);
+				}
+				break;
+			}
+			int r = ugg_recover();
+			printf("UGG EMMC: CMD%u at 0x%llx x%u failed (%d), recover %d, retry %d\n",
+			    idx, sector + done, n, e, r, attempt + 1);
+		}
+		if (e) {
+			return e;
+		}
+		done += n;
+	}
+	/*
+	 * Reads: push what the CPU stored in the FIFO loop out to memory so the
+	 * copy-out sees it. Writes: the same op is harmless and keeps the two
+	 * directions identical.
+	 */
+	clean_dcache64((addr64_t)(su.dma_pa + DMA_BOUNCE), BOUNCE_SIZE, TRUE);
+	return 0;
+}
+
+static int
+ugg_read_blocks(uint64_t lba, uint32_t count)
+{
+	if (count > BOUNCE_SIZE / UFS_BLOCK) {
+		return EINVAL;
+	}
+	return ugg_xfer(lba * UGG_SPB, count * UGG_SPB, false);
+}
+
+/* Only called from ufs_write_blocks after its partition bounds check. */
+static int
+ugg_write_blocks(uint64_t lba, uint32_t count)
+{
+	return ugg_xfer(lba * UGG_SPB, count * UGG_SPB, true);
+}
+
+static int
+ugg_sync_cache(void)
+{
+	static bool warned;
+	/* SWITCH (write byte) EXT_CSD[32] FLUSH_CACHE = 1; harmless with the cache off. */
+	int e = ugg_cmd(6, (3u << 24) | (32u << 16) | (1u << 8), MR_R1B, 0, 0, NULL);
+	if (!e) {
+		e = ugg_card_ready(2000);
+	}
+	if (e && !warned) {
+		warned = true;
+		printf("UGG EMMC: cache flush failed (%d), ignoring\n", e);
+	}
+	return 0;
+}
+
+static int
+ugg_take_over(void)
+{
+	/* Data timeout counter (CLK reg [19:16]) to the maximum, 0xE = TMCLK x 2^27:
+	 * long write-busy (programming) phases must not abort CMD24/CMD25. */
+	mh_wr(M_CLK, (mh_rd(M_CLK) & ~(0xfu << 16)) | (0xeu << 16));
+	int e = ugg_card_ready(500);
+	if (e) {
+		printf("UGG EMMC: card not in transfer state after the shim (%d)\n", e);
+		return ENXIO;
+	}
+	return 0;
+}
+
+static int
+ugg_find_partition(const char *want)
+{
+	const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	int error = ugg_xfer(1, 1, false);
+	if (error) {
+		return error;
+	}
+	if (memcmp(b, "EFI PART", 8) != 0) {
+		printf("UGG EMMC: no GPT\n");
+		return ENXIO;
+	}
+	uint64_t entry_lba;
+	uint32_t nent, esz;
+	memcpy(&entry_lba, b + 72, 8);
+	memcpy(&nent, b + 80, 4);
+	memcpy(&esz, b + 84, 4);
+	if (esz != 128 || nent == 0 || nent * esz > BOUNCE_SIZE) {
+		printf("UGG EMMC: unsupported GPT entries %u x %u\n", nent, esz);
+		return ENXIO;
+	}
+	error = ugg_xfer(entry_lba, (nent * esz + UGG_SECT - 1) / UGG_SECT, false);
+	if (error) {
+		return error;
+	}
+	for (uint32_t i = 0; i < nent; i++) {
+		const uint8_t *e = b + i * esz;
+		char name[37];
+		unsigned c;
+		for (c = 0; c < 36; c++) {
+			uint16_t ch = (uint16_t)(e[56 + 2 * c] | e[57 + 2 * c] << 8);
+			if (ch == 0 || ch > 0x7f) {
+				break;
+			}
+			name[c] = (char)ch;
+		}
+		name[c] = 0;
+		if (strcmp(name, want) != 0) {
+			continue;
+		}
+		uint64_t first, last;
+		memcpy(&first, e + 32, 8);
+		memcpy(&last, e + 40, 8);
+		if (last < first || (first % UGG_SPB)) {
+			printf("UGG EMMC: \"%s\" sectors 0x%llx-0x%llx not 4 KiB aligned\n", want, first, last);
+			return ENXIO;
+		}
+		su.first_block = first / UGG_SPB;
+		su.nblocks = (last - first + 1) / UGG_SPB;
+		/*
+		 * Print on SUCCESS too.
+		 *
+		 * This used to report only failures, so a boot that found the
+		 * partition looked exactly like one that never read the GPT: no
+		 * line at all. The next failure -- a mount against the wrong
+		 * extent -- was then indistinguishable from a missing device.
+		 * first/nblocks are in 4 KiB blocks, which is what su uses.
+		 */
+		printf("UGG EMMC: %s first=%llu nblocks=%llu (%llu MiB)\n",
+		    want, su.first_block, su.nblocks,
+		    (su.nblocks * UGG_SPB) / 2048ull);
+		return 0;
+	}
+	printf("UGG EMMC: no GPT partition named \"%s\"\n", want);
+	return ENOENT;
+}
+#endif /* UGG_BOARD */
