+		uint32_t first_diff = 0xffffffff;
+		for (uint32_t i = 0; i < bytes; i++) {
+			if (a[i] != b[i]) {
+				if (!diff) {
+					first_diff = i;
+				}
+				diff++;
+			}
+		}
+		if (!diff) {
+			printf("UGG XCHECK: r%u block %llu (%u KiB) identical\n",
+			    r, first, bytes >> 10);
+		} else {
+			printf("UGG XCHECK: r%u block %llu (%u KiB) DIFFERS in %u bytes, first at +0x%x\n",
+			    r, first, bytes >> 10, diff, first_diff);
+			printf("UGG XCHECK:   multi :");
+			for (int q = 0; q < 16; q++) {
+				printf(" %02x", b[(first_diff & ~15u) + (uint32_t)q]);
+			}
+			printf("\nUGG XCHECK:   single:");
+			for (int q = 0; q < 16; q++) {
