+	if (ugg_mdp_active() && ugg_mdp_hold_mode() == 2) {
+		ugg_mdp_wait_latch();
+	}
+}
+
+static void
+ugg_mdp_unstage(void)
+{
+	if (ugg_mdp_staged) {
+		MDP_W(CTL0, 0x200);                         /* LM0: RGB0 again */
+		MDP_W(CTL0 + 0x18, 0x8u | 0x40u | 0x20000u);  /* flush RGB0, LM0, CTL */
+		ugg_mdp_staged = false;
+	}
+}
+
+static bool
+ugg_mdp_scanout(SweetSurface *s, int32_t sx, int32_t sy, int32_t w, int32_t h, uint32_t panelw, uint32_t panelh)
+{
+	if (ugg_mdp_mode < 0) {
+		int on = 0;
+		PE_parse_boot_argn("ugg_mdp", &on, sizeof(on));
+		ugg_mdp_mode = on;
+		PE_parse_boot_argn("ugg_mdp_filter", &ugg_mdp_filter, sizeof(ugg_mdp_filter));
+		PE_parse_boot_argn("ugg_mdp_axes", &ugg_mdp_axes, sizeof(ugg_mdp_axes));
+		PE_parse_boot_argn("ugg_mdp_pe", &ugg_mdp_pe, sizeof(ugg_mdp_pe));
+		IOLog("UGG MDP: filter %u axes %u pixel-ext %u\n", ugg_mdp_filter, ugg_mdp_axes, ugg_mdp_pe);
+		ugg_mdp = on ? ml_io_map(0x01a00000, 0x10000) : 0;
+		if (ugg_mdp) {
+			uint32_t ck = MDP_R(0x2ac);
+			MDP_W(0x2ac, ck | 1u);                   /* VIG0 clock force on (mdss-pipe-vig-clk-ctrl) */
+			IOLog("UGG MDP: mode %d, clk ctrl 0x2ac %08x -> %08x\n", on, ck, MDP_R(0x2ac));
+			vm_offset_t gcc = ml_io_map(0x0184d000, 0x1000);   /* GCC mdp_clk_src RCG (read only) */
+			if (gcc) {
+				IOLog("UGG MDP: mdp_clk rcg cmd %08x cfg %08x\n",
+				    *(volatile uint32_t *)(gcc + 0x14), *(volatile uint32_t *)(gcc + 0x18));
+			}
+			MDP_W(0x1018, 0xffffffffu);                /* clear MDP interrupt status */
+		}
+		IOLog("UGG MDP: VIG0 scanout %s\n", ugg_mdp ? "enabled" : "off");
+	}
+	if (ugg_mdp == 0) {
+		return false;
+	}
+	uint64_t pa = s->memory->getPhysicalSegment(0, NULL, kIOMemoryMapperNone) + s->offset;
+	if (s->pixelFormat != 0x42475241u || s->bytesPerElement != 4 || s->planeCount != 0 ||
+	    sx != 0 || sy != 0 || (uint32_t)w != s->width || (uint32_t)h != s->height ||
+	    pa < 0x50000000ull || pa >= 0x70000000ull) {
+		ugg_mdp_unstage();
+		return false;
+	}
+	if (!ugg_mdp_staged || ugg_mdp_cfg_w != (uint32_t)w || ugg_mdp_cfg_h != (uint32_t)h) {
+		bool scale = ugg_mdp_mode == 1;
+		bool sx_on = scale && (ugg_mdp_axes & 1), sy_on = scale && (ugg_mdp_axes & 2);
+		uint32_t cw = sx_on ? (uint32_t)w : panelw, ch = sy_on ? (uint32_t)h : panelh;
+		uint32_t f = ugg_mdp_filter & 3;
+		uint32_t size = (ch << 16) | cw;
+		MDP_W(VIG0 + 0x00, size);                   /* SRC_SIZE */
+		MDP_W(VIG0 + 0x04, size);                   /* SRC_IMG_SIZE */
+		MDP_W(VIG0 + 0x08, 0);                      /* SRC_XY */
+		MDP_W(VIG0 + 0x0c, (panelh << 16) | panelw); /* OUT_SIZE */
+		MDP_W(VIG0 + 0x10, 0);                      /* OUT_XY */
+		MDP_W(VIG0 + 0x28, 0);                      /* STRIDE_B */
+		MDP_W(VIG0 + 0x30, 0x000236ff);             /* format: as LK RGB0 at 32 bpp */
+		MDP_W(VIG0 + 0x34, 0x03020001);             /* unpack B, G, R, X */
+		MDP_W(VIG0 + 0x38, ugg_mdp_pe ? 0x80000000u : 0u);   /* SRC_OP_MODE: SW_PIX_EXT_OVERRIDE */
+		MDP_W(VIG0 + 0xb4, 0);                      /* DECIMATION */
+		MDP_W(VIG0 + 0x200, 0);                     /* OP_MODE: no CSC */
+		/* filters for components 0 (bits 8/10), 1+2 (12/14) and 3 (16/18), X/Y */
+		MDP_W(VIG0 + 0x204, (sx_on ? 1u | (f << 8) | (f << 12) | (f << 16) : 0u) |
+		    (sy_on ? 2u | (f << 10) | (f << 14) | (f << 18) : 0u));
+		/* phase steps and initial phases: components 0+3 (0x210..), 1+2 (0x218..); with the */
+		/* 1+2 step left at 0 that half of the scaler never advanced and the panel underran */
+		uint32_t stx = (uint32_t)(((uint64_t)cw << 21) / panelw), sty = (uint32_t)(((uint64_t)ch << 21) / panelh);
+		MDP_W(VIG0 + 0x210, stx);
+		MDP_W(VIG0 + 0x214, sty);
+		MDP_W(VIG0 + 0x218, stx);
+		MDP_W(VIG0 + 0x21c, sty);
+		MDP_W(VIG0 + 0x220, 0);
+		MDP_W(VIG0 + 0x224, 0);
+		MDP_W(VIG0 + 0x228, 0);
+		MDP_W(VIG0 + 0x22c, 0);
+		for (uint32_t c = 0; c < 3; c++) {          /* SW_PIX_EXT comps 0, 1/2, 3 */
+			MDP_W(VIG0 + 0x100 + c * 0x10, sx_on && ugg_mdp_pe ? 1u << 16 : 0u);    /* LR: 1 right repeat */
+			MDP_W(VIG0 + 0x104 + c * 0x10, sy_on && ugg_mdp_pe ? 1u << 16 : 0u);    /* TB: 1 bottom repeat */
+			MDP_W(VIG0 + 0x108 + c * 0x10, ((ch + (sy_on && ugg_mdp_pe ? 1 : 0)) << 16) | (cw + (sx_on && ugg_mdp_pe ? 1 : 0)));
+		}
+		ugg_mdp_cfg_w = (uint32_t)w;
+		ugg_mdp_cfg_h = (uint32_t)h;
+	}
+	/* ugg's panel: 0x90000000, 720x1280, stride 2880 (mido's 0x90001000/4320 is not this panel) */
+	MDP_W(VIG0 + 0x14, ugg_mdp_mode == 2 ? 0x90000000u : (uint32_t)pa);   /* SRC0_ADDR */
+	MDP_W(VIG0 + 0x24, ugg_mdp_mode == 2 ? 720u * 4u : s->bytesPerRow);   /* STRIDE_A */
+	if (!ugg_mdp_staged) {
+		MDP_W(CTL0, 0x1);                           /* LM0: VIG0 where RGB0 was */
+		MDP_W(CTL0 + 0x18, 0x1u | 0x40u | 0x20000u);  /* flush VIG0, LM0, CTL */
+		ugg_mdp_staged = true;
+	} else {
+		MDP_W(CTL0 + 0x18, 0x1u | 0x20000u);        /* flush VIG0, CTL */
+	}
+	if (++ugg_mdp_flips <= 6 || ugg_mdp_flips % 240 == 1) {
+		uint32_t irq = MDP_R(0x1014);               /* bits 24-27: INTF0-3 underrun */
+		MDP_W(0x1018, irq);
+		IOLog("UGG MDP: flip %u src %08x latched %08x layer %08x flush %08x irq %08x\n", ugg_mdp_flips,
+		    (uint32_t)pa, MDP_R(VIG0 + 0xa4), MDP_R(CTL0), MDP_R(CTL0 + 0x18), irq);
+	}
+	return true;
+}
+/*
+ * Copy canvas rect (sx,sy)+(w,h) shown at canvas (dx,dy) into the panel,
+ * nearest neighbour: panel pixel p shows canvas pixel p * canvas / panel.
+ */
+void
+AppleCLCD::uggPresentScaled(SweetSurface *s, int32_t sx, int32_t sy,
+    int32_t dx, int32_t dy, int32_t w, int32_t h)
+{
+	if (s->elementWidth != 1 || s->elementHeight != 1 || s->memory == NULL) {
+		return;
+	}
+	if (w > (int32_t)s->width - sx) {
+		w = (int32_t)s->width - sx;
+	}
+	if (h > (int32_t)s->height - sy) {
+		h = (int32_t)s->height - sy;
+	}
+	if (w > (int32_t)fLogicalW - dx) {
+		w = (int32_t)fLogicalW - dx;
+	}
+	if (h > (int32_t)fLogicalH - dy) {
+		h = (int32_t)fLogicalH - dy;
+	}
+	if (w <= 0 || h <= 0) {
+		return;
+	}
+	uint64_t last = (uint64_t)s->offset + (uint64_t)(sy + h - 1) * s->bytesPerRow +
+	    (uint64_t)(sx + w) * 4;
+	if (last > s->memory->getLength()) {
+		return;
+	}
+	if (ugg_mdp_scanout(s, sx, sy, w, h, fWidth, fHeight)) {
+		return;
+	}
+	uintptr_t base = s->kernelAddress() + s->offset;
+	uint64_t ugg_t0 = mach_absolute_time();
+	if (s->mapCache == kIOMapWriteCombineCache && base != s->offset) {
+		/* GPU memory read through a cached view: drop stale lines first */
+		flush_dcache((vm_offset_t)(base + (uint64_t)sy * s->bytesPerRow), (unsigned)((uint64_t)h * s->bytesPerRow), FALSE);
+	}
+	uint64_t ugg_t1 = mach_absolute_time();
+	uint32_t stepx = (fLogicalW << 16) / fWidth, stepy = (fLogicalH << 16) / fHeight;
+	/*
+	 * backboardd renders the D211 (P3 wide colour) UI in kCVPixelFormatType_30RGBLE_8A
+	 * ('b3a8', 2 planes): plane 0 words are R[29:20] G[19:10] B[9:0], extended range
+	 * 384 = 0.0 .. 895 = 1.0; alpha is in plane 1 (ignored, the result is opaque).
+	 * Copied raw as BGRA, black came out navy and white pale yellow (run #22 lock screen).
+	 */
+	static uint8_t xr10[1024];
+	static bool xr10_ready;
+	bool wide = (s->pixelFormat == 0x62336138u);   /* 'b3a8' */
+	if (wide && !xr10_ready) {
+		for (int v = 0; v < 1024; v++) {
+			int c = ((v - 384) * 255 + 255) / 511;
+			xr10[v] = (uint8_t)(c < 0 ? 0 : c > 255 ? 255 : c);
+		}
+		xr10_ready = true;
+		IOLog("SWEET FB: converting b3a8 (30RGBLE_8A, XR 384..895) surfaces to BGRA\n");
+	}
+	/* panel range whose canvas pixel falls inside [d, d + len) */
+	uint32_t px0 = (uint32_t)(((uint64_t)dx << 16) + stepx - 1) / stepx;
+	uint32_t px1 = (uint32_t)(((uint64_t)(dx + w) << 16) + stepx - 1) / stepx;
+	uint32_t py0 = (uint32_t)(((uint64_t)dy << 16) + stepy - 1) / stepy;
+	uint32_t py1 = (uint32_t)(((uint64_t)(dy + h) << 16) + stepy - 1) / stepy;
+	px1 = MIN(px1, fWidth);
+	py1 = MIN(py1, fHeight);
+	for (uint32_t py = py0; py < py1; py++) {
+		int32_t ly = (int32_t)((py * stepy) >> 16) - dy;
+		if (ly < 0 || ly >= h) {
+			continue;
+		}
+		const uint32_t *srow = (const uint32_t *)(base + (uint64_t)(sy + ly) * s->bytesPerRow) + sx;
+		uint32_t *drow = (uint32_t *)(fPixels + (uint64_t)py * fRowBytes);
+		for (uint32_t px = px0; px < px1; px++) {
+			int32_t lx = (int32_t)((px * stepx) >> 16) - dx;
+			if (lx >= 0 && lx < w) {
+				uint32_t v = srow[lx];
+				if (wide) {
+					v = 0xff000000u | (uint32_t)xr10[(v >> 20) & 0x3ff] << 16 |
+					    (uint32_t)xr10[(v >> 10) & 0x3ff] << 8 | xr10[v & 0x3ff];
+				}
+				drow[px] = v;
+			}
+		}
+	}
+	static uint32_t ugg_n;
+	static uint64_t ugg_flush, ugg_copy;
+	uint64_t ugg_t2 = mach_absolute_time();
+	ugg_flush += ugg_t1 - ugg_t0;
+	ugg_copy += ugg_t2 - ugg_t1;
+	if (++ugg_n == 120) {
+		IOLog("UGG FB: %d x %d copy avg flush %llu us, copy %llu us (cached %d)\n", w, h,
+		    ugg_flush * 10 / 192 / ugg_n, ugg_copy * 10 / 192 / ugg_n, s->mapCache == kIOMapWriteCombineCache);
+		ugg_n = 0;
+		ugg_flush = ugg_copy = 0;
+	}
+}
