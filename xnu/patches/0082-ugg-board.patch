+int
+ml_get_cluster_number(uint32_t phys_id)
+{
+	int cpu_id = ml_get_cpu_number(phys_id);
+	if (cpu_id < 0) {
+		return -1;
+	}
+
+	ml_topology_cpu_t *cpu = &topology_info.cpus[cpu_id];
+
+	return cpu->cluster_id;
+}
+
+unsigned int
+ml_get_cpu_number_local(void)
+{
+	uint64_t mpidr_el1_value = 0;
+	unsigned cpu_id;
+
+	/* We identify the CPU based on the constant bits of MPIDR_EL1. */
+	MRS(mpidr_el1_value, "MPIDR_EL1");
+	cpu_id = ml_get_cpu_number((uint32_t)mpidr_el1_value);
+
+	/*
+	 * UGG: do not die here.
+	 *
+	 * Upstream asserts that the CPU we are executing on appears in the
+	 * topology table. On this board it does not: the phone panics at
+	 * machine_routines.c with "assertion failed:
+	 * cpu_id <= (unsigned int)ml_get_max_cpu_number()" during
+	 * kernel_startup_bootstrap, because the MPIDR_EL1 of the core we were
+	 * handed by the bootloader has no matching 'reg' in the topology that the
+	 * Apple device tree supplied.
+	 *
+	 * Falling back to the boot CPU is correct for the bring-up, which is
+	 * uniprocessor: there is exactly one CPU running, it is the boot CPU, and
+	 * the only thing this value is used for is selecting the right per-CPU
+	 * structure. A line is printed on the bootstrap console so the fallback is
+	 * visible in a photograph instead of being silently papered over.
+	 */
+	if (cpu_id < 0 || cpu_id > (unsigned int)ml_get_max_cpu_number()) {
+		/*
+		 * Deliberately NOT printf(). This runs inside kernel_startup_bootstrap(),
+		 * which is where printf itself is being brought up, so calling it here
+		 * risks recursing into an uninitialised console. sweet_early_mark() is
+		 * the bootstrap console and is what printed the stage banners already.
+		 */
+		sweet_early_mark(90, "cpu map: unknown core, using boot cpu");
+		cpu_id = (unsigned int)ml_get_boot_cpu_number();
+	}
+
+	return cpu_id;
+}
+
+int
+ml_get_cluster_number_local()
+{
+	uint64_t mpidr_el1_value = 0;
+	unsigned cluster_id;
+
+	/* We identify the cluster based on the constant bits of MPIDR_EL1. */
+	MRS(mpidr_el1_value, "MPIDR_EL1");
+	cluster_id = ml_get_cluster_number((uint32_t)mpidr_el1_value);
+
+	/* UGG: same unmapped-CPU case as ml_get_cpu_number_local(); boot cluster wins. */
+	if (cluster_id > (unsigned int)ml_get_max_cluster_number()) {
+		cluster_id = (unsigned int)topology_info.boot_cluster->cluster_id;
+	}
+
+	return cluster_id;
+}
