+						printf("UGG CHECK: BAD node=%u fLink=0x%08x bLink=0x%08x kind=0x%02x\n",
+						    idx, fLink, bLink, kind);
+					}
+					if (mode >= 2 && bad == 1) {
+						printf("UGG CHECK: first 32 bytes:");
+						for (int q = 0; q < 32; q++) {
