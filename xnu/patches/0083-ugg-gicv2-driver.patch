+	__builtin_arm_isb(ISB_SY);
+#else
 	uint64_t sgi = (((mpidr >> 32) & 0xff) << 48) |
 	    (((mpidr >> 16) & 0xff) << 32) |
 	    (((mpidr >> 8) & 0xff) << 16) |
@@ -227,6 +248,7 @@ SweetCPU::signalCPU(IOCPU *target)
