 }
+#elif defined(UGG_GIC_V2)
+/*
+ * GICv2 for Qualcomm SoCs without redistributors (MSM8937/MSM8940,
+ * "qcom,msm-qgic2"): two MMIO frames, the distributor and one per-core CPU
+ * interface. There is no ICC_* system register for the acknowledge path -
+ * only the Group 1 enable stays a system register.
+ *
+ * Like the GICv3 SWEET path: Qualcomm's GIC has two security states and
+ * TrustZone owns Group 0, so everything this kernel owns is Group 1 and
+ * arrives as an IRQ through sleh_irq().
+ */
+
+static vm_offset_t gicd_base;
+static vm_offset_t gicc_base;
+
+static uint32_t
+_gic2_read32(vm_offset_t addr)
+{
+	return *((volatile uint32_t *) addr);
+}
+
+static void
+_gic2_write32(vm_offset_t addr, uint32_t value)
+{
+	*((volatile uint32_t *) addr) = value;
+}
+
+#define gicd2_read32(offset) (_gic2_read32(gicd_base + (offset)))
+#define gicd2_write32(offset, data) (_gic2_write32(gicd_base + (offset), (data)))
+#define gicc2_read32(offset) (_gic2_read32(gicc_base + (offset)))
+#define gicc2_write32(offset, data) (_gic2_write32(gicc_base + (offset), (data)))
+
+/* GICv2: acknowledge from the CPU interface's IAR, complete through EOIR. */
+uint64_t
+sweet_gic_ack(void)
+{
+	return gicc2_read32(GICC_IAR);
+}
+
+void
+sweet_gic_eoi(uint64_t iar)
+{
+	gicc2_write32(GICC_EOIR, (uint32_t)iar);
+}
+
+/*
+ * GICv2 SGI: write the distributor's GICD_SGIR. The caller supplies the
+ * encoded value (INTID in [23:16], target list in [15:0]).
+ */
+void
+sweet_gic_send_sgi(uint32_t sgir)
+{
+	gicd2_write32(GICD_SGIR, sgir);
+}
+
+void
+pe_init_fiq()
+{
+	int error;
+	DTEntry entry;
+	void const *prop;
+	unsigned int prop_size;
+
+	/*
+	 * gicd_base is 0 only before the boot CPU has initialised it. Secondary
+	 * CPUs must not call the SecureDT routines (they are not thread-safe).
+	 */
+	if (!gicd_base) {
+		error = SecureDTLookupEntry(NULL, "/arm-io/gic", &entry);
+		if (error != kSuccess) {
+			panic("%s: cannot find GIC node in DT", __func__);
+		}
+
+		error = SecureDTGetProperty(entry, "reg", &prop, &prop_size);
+		if (error != kSuccess) {
+			panic("%s: cannot find GIC MMIO regions in DT", __func__);
+		}
+		/* GICD base/size then GICC base/size: four 8-byte cells. */
+		if (prop_size < 4 * sizeof(uint64_t)) {
+			panic("%s: GIC reg has %u bytes, expected at least 32", __func__, prop_size);
+		}
+
+		/* Same per-SoC timer override as the GICv3 path. */
+		void const *timer_prop;
+		unsigned int timer_size;
+		if (SecureDTGetProperty(entry, "virtual-timer-intid", &timer_prop, &timer_size) == kSuccess) {
+			if (timer_size != sizeof(uint32_t)) {
+				panic("%s: invalid virtual-timer-intid size %u", __func__, timer_size);
+			}
+			uint32_t intid = *(const uint32_t *)timer_prop;
+			if (intid < 16 || intid >= 32) {
+				panic("%s: virtual timer INTID %u is not a PPI", __func__, intid);
+			}
+			sweet_vtimer_intid = intid;
+		}
+		kprintf("SWEET GIC: v2 virtual timer INTID %u\n", sweet_vtimer_intid);
+
+		vm_offset_t soc_base_phys = pe_arm_get_soc_base_phys();
+		uint64_t const gicd_base_prop = ((uint64_t const *) prop)[0];
+		uint64_t const gicd_size_prop = ((uint64_t const *) prop)[1];
+		uint64_t const gicc_base_prop = ((uint64_t const *) prop)[2];
+		uint64_t const gicc_size_prop = ((uint64_t const *) prop)[3];
+
+		gicd_base = ml_io_map(soc_base_phys + gicd_base_prop, gicd_size_prop);
+		if (!gicd_base) {
+			panic("%s: cannot map GICD region", __func__);
+		}
+		gicc_base = ml_io_map(soc_base_phys + gicc_base_prop, gicc_size_prop);
+		if (!gicc_base) {
+			panic("%s: cannot map GICC region", __func__);
+		}
+
+		kprintf("SWEET GIC: v2 distributor %p cpu-interface %p\n",
+		    (void *)gicd_base, (void *)gicc_base);
+	}
+
+	/* Forward Group 1 to the CPU interfaces and wait for the write to land. */
+	gicd2_write32(GICD_CTLR, gicd2_read32(GICD_CTLR) | GICD_CTLR_ENABLE);
+	while (gicd2_read32(GICD_CTLR) & GICD_CTLR_RWP) {
+		;
+	}
+
+	/*
+	 * SGI/PPI registers (INTID 0-31) are banked per CPU in GICv2: every
+	 * core configures its own view. Only the CTLR update above is global.
+	 */
+	/* All SGIs/PPIs we own are Group 1 (non-secure; TZ owns Group 0). */
+	for (unsigned int i = 0; i < 32; i += 4) {
+		gicd2_write32(GICD_IGROUPR + i, 0xffffffff);
+	}
+
+	/* Priority 0xa0 everywhere, so PMR 0xff admits everything. */
+	for (unsigned int i = 0; i < 32; i += 4) {
+		gicd2_write32(GICD_IPRIORITYR + i, 0xa0a0a0a0);
+	}
+
+	/* The virtual timer PPI is level-sensitive: ICFGR bit pair 0. */
+	gicd2_write32(GICD_ICFGR + 4, 0);
+
+	gicd2_write32(GICD_ISENABLER, (1U << sweet_vtimer_intid) | (1U << SWEET_IPI_SGI));
+
+	/* CPU interface: admit all priorities, no binary point, enable. */
+	gicc2_write32(GICC_PMR, 0xff);
+	gicc2_write32(GICC_BPR, 0);
+	gicc2_write32(GICC_CTLR, 1);
+
+	/* Group 1 enable is still a system register, even on GICv2. */
+	uint64_t icc_sre = __builtin_arm_rsr64("ICC_SRE_EL1");
+	__builtin_arm_wsr64("ICC_SRE_EL1", icc_sre | ICC_SRE_SRE);
+	__builtin_arm_isb(ISB_SY);
+	__builtin_arm_wsr64("ICC_IGRPEN1_EL1", 1);
+	__builtin_arm_isb(ISB_SY);
+}
 #else
 void
 pe_init_fiq()
