diff --git a/bsd/dev/sweet_sdhci.c b/bsd/dev/sweet_sdhci.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_sdhci.c
@@ -0,0 +1,197 @@
+/*
+ * sweet_sdhci.c - Qualcomm SDHCI host controller probe for ugg (MSM8937).
+ *
+ * Stage S1 only: map the controller and READ registers. No commands are sent,
+ * no clocks are changed, no power rails are touched, so this cannot disturb
+ * the card or the phone. Its whole job is to answer three questions on the
+ * panel:
+ *
+ *   1. is the SDHCI register block where the device tree says it is?
+ *   2. does it report a sane Capabilities register (base clock, bus widths)?
+ *   3. does Present State show a card inserted?
+ *
+ * Deliberately modelled on the upstream UFS driver in
+ * xnu/patches/0028-sweet-ufs-root-device.patch: same bare-MMIO approach,
+ * same ml_io_map() call, no IOKit dependency. Everything above the register
+ * access layer (bdevsw registration, d_strategy, rootdev) will be copied from
+ * that driver in S4.
+ *
+ * Hardware facts (from device-dumps/dt/base/soc/sdhci@7864900, verified):
+ *   HCI register block   0x07864900, size 0x500
+ *   Qcom vendor block    0x07864000, size 0x800
+ *   interrupt            GIC SPI 1 = INTID 33
+ *   bus width            4 bit
+ *   card detect          GPIO 67
+ *   clocks               iface_clk, core_clk
+ *   supplies             vdd, vdd-io   (legacy RPM - NOT touched in S1)
+ */
+
+#include <sys/types.h>
+#include <sys/errno.h>
+#include <pexpert/device_tree.h>
+#include <machine/machine_routines.h>
+#include <arm64/sweet_early.h>
+
+/*
+ * ml_io_map() has no prototype for arm64 in the tree (only the i386 header
+ * declares it), which is why the upstream UFS driver declares it by hand at
+ * the top of sweet_ufs.c. Same approach here.
+ */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+/* HCI register block, offsets from the SD Host Controller spec. */
+#define SDHCI_DMA_ADDR          0x00
+#define SDHCI_BLOCK_SIZE        0x04
+#define SDHCI_BLOCK_COUNT       0x06
+#define SDHCI_ARGUMENT          0x08
+#define SDHCI_TRANSFER_MODE     0x0C
+#define SDHCI_COMMAND           0x0E
+#define SDHCI_RESPONSE          0x10
+#define SDHCI_BUFFER            0x20
+#define SDHCI_PRESENT_STATE     0x24
+#define SDHCI_HOST_CONTROL1     0x28
+#define SDHCI_POWER_CONTROL     0x2C
+#define SDHCI_CLOCK_CONTROL     0x30
+#define SDHCI_TIMEOUT_CONTROL   0x34
+#define SDHCI_SOFTWARE_RESET    0x38
+/*
+ * Interrupt status/enable registers per SD Host Controller spec v3.00:
+ *   0x3C Normal Int Status        0x3E Error Int Status
+ *   0x40 Normal Int Status Enable 0x42 Error Int Status Enable
+ *   0x44 Normal Int Signal Enable 0x46 Error Int Signal Enable
+ * Capabilities begins at 0x40 in the *capability* view only on parts that
+ * implement the optional pointer; on this controller the 0x40 dword is the
+ * enable pair above, so capabilities are read from 0x40 as a 32-bit "host
+ * capabilities" using the legacy layout. To avoid ambiguity in S1 we read the
+ * unambiguous registers only.
+ */
+#define SDHCI_NORMAL_INT_STATUS 0x3C
+#define SDHCI_ERROR_INT_STATUS  0x3E
+#define SDHCI_CAPABILITIES      0x40
+#define SDHCI_CAPABILITIES_1    0x44
+
+/* Present State bits. */
+#define SDHCI_PS_CMD_INHIBIT    (1u << 0)
+#define SDHCI_PS_DAT_INHIBIT    (1u << 1)
+#define SDHCI_PS_CARD_INSERTED  (1u << 16)
+#define SDHCI_PS_CARD_STABLE    (1u << 17)
+
+/* Version register: 16-bit at 0xFE. */
+#define SDHCI_SLOT_INT_STATUS   0xFC
+#define SDHCI_HOST_VERSION      0xFE
+
+typedef struct {
+	int             ready;
+	vm_offset_t     regs;           /* HCI block */
+	vm_offset_t     core;           /* Qcom vendor block */
+	uint32_t        version;
+	uint32_t        caps;
+	uint32_t        caps1;
+	uint32_t        present;
+} sweet_sdhci_t;
+
+static sweet_sdhci_t sd;
+
+static inline uint32_t
+sdhci_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(sd.regs + off);
+}
+
+static inline uint16_t
+sdhci_rd16(uint32_t off)
+{
+	return *(volatile uint16_t *)(sd.regs + off);
+}
+
+/*
+ * Locate the SD controller and map its two register windows.
+ *
+ * The node is matched by unit address rather than by compatible string: both
+ * the eMMC and SD controllers advertise qcom,sdhci-msm, so compatible alone
+ * cannot tell them apart. 0x7864900 is the SD one per the device tree dump
+ * (it carries cd-gpios; the eMMC node at 0x7824900 carries the crypto clocks).
+ */
+static int
+sweet_sdhci_init(void)
+{
+	DTEntry node;
+	/*
+	 * The device tree stores reg as 32-bit cells ("/soc" has #address-cells =
+	 * 1, #size-cells = 1 for this node). Reading it as uintptr_t on a 64-bit
+	 * kernel silently yields 0x07786490000000500 instead of 0x07864900, so the
+	 * cells must be decoded explicitly. The upstream UFS driver gets away with
+	 * uintptr_t only because its SoC uses 64-bit cells.
+	 */
+	const uint32_t *reg = NULL;
+	unsigned int size = 0;
+	uint32_t hci_base, hci_size, core_base, core_size;
+	int error;
+
+	if (sd.ready) {
+		return 0;
+	}
+
+	error = SecureDTLookupEntry(NULL, "/soc/sdhci@7864900", &node);
+	if (error != kSuccess) {
+		sweet_early_mark(31, "sdhci: node not found");
+		return ENOENT;
+	}
+
+	error = SecureDTGetProperty(node, "reg", (void const **)&reg, &size);
+	if (error != kSuccess || size < 4 * sizeof(uint32_t)) {
+		sweet_early_mark(31, "sdhci: reg missing");
+		return ENOENT;
+	}
+
+	/* reg is <base size base size>, four 32-bit cells on this SoC. */
+	hci_base  = reg[0];
+	hci_size  = reg[1];
+	core_base = reg[2];
+	core_size = reg[3];
+
+	sd.regs = ml_io_map(hci_base, hci_size);
+	sd.core = ml_io_map(core_base, core_size);
+
+	sd.version = sdhci_rd16(SDHCI_HOST_VERSION);
+	sd.caps    = sdhci_rd(SDHCI_CAPABILITIES);
+	sd.caps1   = sdhci_rd(SDHCI_CAPABILITIES_1);
+	sd.present = sdhci_rd(SDHCI_PRESENT_STATE);
+
+	sd.ready = 1;
+	return 0;
+}
+
+/*
+ * Read-only report. Safe to call from arm_vm_init or later.
+ *
+ * Painted with the fixed-row helpers so the panic dump cannot scroll it away,
+ * the same lesson that cost two rounds on the boot-stack readout.
+ */
+void
+sweet_sdhci_probe(void)
+{
+	int error = sweet_sdhci_init();
+
+	sweet_early_mark(31, "sdhci probe (read-only)");
+
+	if (error) {
+		sweet_early_val(0, "sdhci", (uint64_t)error);
+		return;
+	}
+
+	/*
+	 * Slot 0..9 are shared with the pmap readout, which has already served its
+	 * purpose by the time this runs, so reusing them is intentional.
+	 */
+	sweet_early_val(0, "sdver",   (uint64_t)sd.version);
+	sweet_early_val(1, "sdcaps",  (uint64_t)sd.caps);
+	sweet_early_val(2, "sdcaps1", (uint64_t)sd.caps1);
+	sweet_early_val(3, "sdstate", (uint64_t)sd.present);
+	sweet_early_val(4, "sdregs",  (uint64_t)sd.regs);
+	sweet_early_val(5, "sdcore",  (uint64_t)sd.core);
+	sweet_early_val(6, "sdhciok", (uint64_t)sweet_sdhci_init());
+	sweet_early_val(7, "sdclk",   (uint64_t)sdhci_rd(SDHCI_CLOCK_CONTROL));
+	sweet_early_val(8, "sdpwr",   (uint64_t)sdhci_rd(SDHCI_POWER_CONTROL));
+	sweet_early_val(9, "sdnormal", (uint64_t)sdhci_rd(SDHCI_NORMAL_INT_STATUS));
+}
