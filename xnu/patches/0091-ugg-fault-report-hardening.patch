  * panic() then is the misleading "Invalid kernel stack pointer", and the real
  * fault is lost. Printing the pc/esr/far here names it.
  */
+/*
+ * Print one 64-bit value with no varargs, no _doprnt and no register reads.
+ *
+ * The fault reporter MUST NOT depend on anything that can fault again. The
+ * first version called sweet_early_vprint() (which pulls in _doprnt) and then
+ * read SP_EL0 to describe the boot stack; on 0090 the panel filled with
+ * hundreds of "SWEET FAULT sync" blocks whose pc sat at _sweet_early_fault
+ * + 0x140, i.e. the reporter itself was the thing faulting, each pass pushing
+ * another ~1216-byte frame onto the same stack and re-faulting. That loop hid
+ * the real fault it was supposed to reveal.
+ */
+static void
+sweet_early_hex64(uint64_t v)
+{
+	static const char digits[] = "0123456789abcdef";
+
+	for (int shift = 60; shift >= 0; shift -= 4) {
+		sweet_early_putc(digits[(v >> shift) & 0xf]);
+	}
+}
+
+static void
+sweet_early_hex32(uint32_t v)
+{
+	static const char digits[] = "0123456789abcdef";
+
+	for (int shift = 28; shift >= 0; shift -= 4) {
+		sweet_early_putc(digits[(v >> shift) & 0xf]);
+	}
+}
+
 void
 sweet_early_fault(const char *tag, uint64_t pc, uint64_t lr, uint64_t sp,
     uint32_t esr, uint64_t far)
 {
-	if (early_disabled) {
-		return;
-	}
+	/*
+	 * Report exactly one fault. A second one means this reporter (or the
+	 * handler around it) is itself broken, and looping on it buries the
+	 * information we are trying to print instead of reporting it.
+	 */
+	if (early_disabled || early_fault_reported) {
+		return;
+	}
+	early_fault_reported = 1;
+
 	sweet_early_string("\nSWEET FAULT ");
 	sweet_early_string(tag);
-	sweet_early_vprint("\n pc %016llx  lr %016llx"
-	    "\n sp %016llx  esr %08x  far %016llx\n",
-	    (unsigned long long)pc, (unsigned long long)lr,
-	    (unsigned long long)sp, (unsigned int)esr, (unsigned long long)far);
-	sweet_early_string(" istack:");
-	sweet_early_stackinfo();
+	sweet_early_string("\n pc ");
+	sweet_early_hex64(pc);
+	sweet_early_string(" lr ");
+	sweet_early_hex64(lr);
+	sweet_early_string("\n sp ");
+	sweet_early_hex64(sp);
+	sweet_early_string(" esr ");
+	sweet_early_hex32(esr);
+	sweet_early_string("\n far ");
+	sweet_early_hex64(far);
+	sweet_early_putc('\n');
+	/*
+	 * Deliberately NOT calling sweet_early_stackgauge() here. It reads SP_EL0,
+	 * and the 0090 panel showed the reporter faulting with pc exactly on
+	 * "mrs x10, SP_EL0", esr 0x02000000 (EC 0, unknown reason). The gauge is
+	 * painted by every stage marker already, so the last reading is still on
+	 * the panel without touching a system register from an exception handler
+	 * that may be running on an already broken stack.
+	 */
 	__asm__ volatile("dsb sy" ::: "memory");
 }
 
