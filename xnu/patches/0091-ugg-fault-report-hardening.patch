+#define EARLY_TEXT_ROWS (EARLY_ROWS - 1u)
+#define EARLY_GAUGE_ROW (EARLY_ROWS - 1u)
+/*
+ * Leave the first character cell blank. The phone's active area starts at the
+ * panel edge, so text drawn in column 0 is cut in half by the bezel; the 0090
+ * photograph lost the leading characters of several register lines that way
+ * ("00000" appeared as "30000"), which made the printed addresses ambiguous.
+ * One blank column costs nothing and every value becomes readable.
+ */
+#define EARLY_LEFT_MARGIN 1u
+/* Columns actually usable for text once the left margin is taken. */
+#define EARLY_TEXT_COLS (EARLY_COLS - EARLY_LEFT_MARGIN)
 
