diff --git a/osfmk/mach/arm/vm_param.h b/osfmk/mach/arm/vm_param.h
--- a/osfmk/mach/arm/vm_param.h
+++ b/osfmk/mach/arm/vm_param.h
@@ -349,12 +349,30 @@
  * 95.9% of the stack already consumed before any fault was handled.
  * CHECK_KERNEL_STACK then ran, found SP_EL0 below the stack, and panicked
  * correctly: the guard page turned a silent stack smash into a reported
- * fault, at the cost of stopping the boot. Give UGG a 4x early stack; these
- * are per CPU and the memory is negligible on a 4 GiB device. The assembly
- * checks read INTSTACK_SIZE_NUM from genassym, so they follow this constant.
+ * fault, at the cost of stopping the boot.
+ *
+ * 0090 gave UGG a 4x stack (64 KiB) and 0094 finally measured the real need.
+ * The panel's fixed readout proved the pmap tables themselves were fine, and
+ * the panic sp of 0xfffffe00080afe30 then gives the arithmetic directly:
+ *
+ *   SP_EL0 before the frame   0xfffffe00080b0180   (384 B above the base)
+ *   consumed from the top     65,152 B
+ *   the incoming frame           848 B
+ *   total needed              66,000 B
+ *   stack available           65,536 B
+ *   shortfall                    464 B     <- exactly how far sp went past base
+ *
+ * So 64 KiB was close but not enough: the chain consumed 65,152 bytes before
+ * the exception that ended the boot. A 4x stack was not enough; 16x gives
+ * 256 KiB, i.e. 3.9x the measured requirement, and the exception stack grows
+ * with it because both are derived from this same scale.
+ *
+ * These are per CPU and the memory is negligible on a 4 GiB device. The
+ * assembly checks read INTSTACK_SIZE_NUM from genassym, so they follow this
+ * constant automatically.
  */
 #if defined(BOARD_UGG) || defined(BOARD_UGGLITE)
-#define INTSTACK_SCALE          (4)
+#define INTSTACK_SCALE          (16)
 #else
 #define INTSTACK_SCALE          (1)
 #endif
