@@ -1357,10 +1383,30 @@
 #define ARM_TT_TWIG_SHIFT      ARM_TT_L2_SHIFT
 #define ARM_TT_TWIG_INDEX_MASK ARM_TT_L2_INDEX_MASK
 
+/*
+ * The kernel's page-table walk for ugg starts at level 0.
+ *
+ * The generic 4K configurations and every 16K build put the root at L1 (a
+ * 38/39-bit VA, T0SZ 25 or 26). ugg sets T0SZ=T1SZ=16 for a 48-bit VA, where
+ * the root is L0 and one entry covers 512GB, so cpu_tte is an L0 table and
+ * navigating it as if it were an L1 indexes it with the wrong bits. Anything
+ * that walks cpu_tte must use ARM_TT_ROOT_* (and ARM_TT_ROOT_LEVEL to know how
+ * many levels it has to descend); otherwise the entry is written at index 0
+ * while the hardware reads index 0x1fc, and the first fetch faults.
+ */
+#if defined(UGG)
+#define ARM_TT_ROOT_SIZE       ARM_TT_L0_SIZE
+#define ARM_TT_ROOT_OFFMASK    ARM_TT_L0_OFFMASK
+#define ARM_TT_ROOT_SHIFT      ARM_TT_L0_SHIFT
+#define ARM_TT_ROOT_INDEX_MASK ARM_TT_L0_INDEX_MASK
+#define ARM_TT_ROOT_LEVEL      0
+#else
 #define ARM_TT_ROOT_SIZE       ARM_TT_L1_SIZE
 #define ARM_TT_ROOT_OFFMASK    ARM_TT_L1_OFFMASK
 #define ARM_TT_ROOT_SHIFT      ARM_TT_L1_SHIFT
 #define ARM_TT_ROOT_INDEX_MASK ARM_TT_L1_INDEX_MASK
+#define ARM_TT_ROOT_LEVEL      1
+#endif
 
