diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
index b88c163..3c8e7f7 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -29,7 +29,7 @@ SUPPORTED_ARM64_MACHINE_CONFIGS = NONE
 else ifneq ($(findstring _host,$(RC_ProjectName)),)
 SUPPORTED_ARM64_MACHINE_CONFIGS = NONE
 else
-SUPPORTED_ARM64_MACHINE_CONFIGS = BCM2837 T6000 T8101 T8103 VMAPPLE SWEET
+SUPPORTED_ARM64_MACHINE_CONFIGS = BCM2837 T6000 T8101 T8103 VMAPPLE SWEET UGG
 
 endif
 
@@ -61,7 +61,16 @@ MACHINE_FLAGS_ARM64_T8103 = -DARM64_BOARD_CONFIG_T8103                  -mcpu=ap
 MACHINE_FLAGS_ARM64_T6000 = -DARM64_BOARD_CONFIG_T6000 		-mcpu=apple-a14
 MACHINE_FLAGS_ARM64_VMAPPLE = -DARM64_BOARD_CONFIG_VMAPPLE              -march=armv8.5a
 MACHINE_FLAGS_ARM64_BCM2837 = -DARM64_BOARD_CONFIG_BCM2837
-MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET                -march=armv8.2-a+crypto
+MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET -DSWEET_FAMILY       -march=armv8.2-a+crypto
+# Cortex-A53 is ARMv8.0: it has no LSE atomics (ID_AA64ISAR0_EL1[23:20] = 0),
+# so ldadd/ldclr/ldset/swp are UNDEFINED there. -march=armv8-a alone is NOT
+# enough: with Apple clang and -mkernel, __c11_atomic_* still lower to LSE
+# (the ugglite 0087 kernel shipped 825 of them and faulted on the first one
+# executed). -mcpu=cortex-a53 makes the backend emit the LL/SC pair
+# (ldaxr/stxr) instead. BOARD_UGG names the board in early assembly, which
+# does not include board_config.h; SWEET_FAMILY is a -D flag precisely
+# because 20+ translation units test it without including board_config.h.
+MACHINE_FLAGS_ARM64_UGG = -DARM64_BOARD_CONFIG_UGG -DBOARD_UGG -DSWEET_FAMILY -mcpu=cortex-a53
 
 
 #
diff --git a/osfmk/arm/commpage/commpage_asm.s b/osfmk/arm/commpage/commpage_asm.s
index da0bbba..03713e7 100644
--- a/osfmk/arm/commpage/commpage_asm.s
+++ b/osfmk/arm/commpage/commpage_asm.s
@@ -272,9 +272,22 @@ _pfz_trylock_and_enqueue:
 	mov		w10, wzr		 // unlock value = w10 = 0
 	mov		w11, #1			 // locked value = w11 = 1
 
-	// Try to grab the lock
+	// Try to grab the lock.
+	// Cortex-A53 is ARMv8.0 and has no LSE atomics, so casa (ARMv8.1) is
+	// UNDEFINED there. The LL/SC pair below gives the same observable
+	// behaviour: acquire from ldaxr, release from the stlr that drops the
+	// lock; an SC collision is treated as a failed try, like casa's.
+#if defined(BOARD_UGG)
+	ldaxr	w10, [x3]
+	cbnz	w10, Ltrylock_enqueue_slow
+	stxr	w12, w11, [x3]
+	cbnz	w12, Ltrylock_enqueue_slow
+	b	Ltrylock_enqueue_success
+Ltrylock_enqueue_slow:
+#else
 	casa	w10, w11, [x3]	 // Atomic CAS with acquire barrier
 	cbz		w10, Ltrylock_enqueue_success
+#endif
 
 	mov		x0, #-1			// Failed
 	b Ltrylock_enqueue_exit
@@ -323,8 +336,18 @@ _pfz_trylock_and_dequeue:
 	mov		w10, wzr		 // unlock value = w10 = 0
 	mov		w11, #1			 // locked value = w11 = 1
 
+	// Same LL/SC substitution as pfz_trylock_and_enqueue: no LSE on A53.
+#if defined(BOARD_UGG)
+	ldaxr	w10, [x2]
+	cbnz	w10, Ltrylock_dequeue_slow
+	stxr	w12, w11, [x2]
+	cbnz	w12, Ltrylock_dequeue_slow
+	b	Ltrylock_dequeue_success
+Ltrylock_dequeue_slow:
+#else
 	casa	w10, w11, [x2]	 // Atomic CAS with acquire barrier
 	cbz		w10, Ltrylock_dequeue_success
+#endif
 
 	mov		x0, #-1			// Failed
 	b Ltrylock_dequeue_exit
diff --git a/osfmk/arm/pmap/pmap.c b/osfmk/arm/pmap/pmap.c
index 00568d3..e1bf2f8 100644
--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -10984,8 +10984,21 @@ static_assert((_COMM_PAGE32_BASE_ADDRESS & ~ARM_TT_L2_OFFMASK) >= VM_MAX_ADDRESS
 /**
  * Ensure that 64-bit devices using 4K pages can nest the commpage completely
  * above the maximum userspace VA.
- */
+ *
+ * SWEET_FAMILY (4K-granule Qualcomm boards): the macOS build defines
+ * XNU_PLATFORM_MacOSX, which raises MACH_VM_MAX_ADDRESS to 0x7ffffe000000
+ * (128TB) - a range this kernel's 48-bit VA cannot address, and which no
+ * 4K-granule device with the standard commpage placement could satisfy.
+ * Compare against the value the iPhoneOS userspace actually gets, so the
+ * check keeps its meaning (the commpage nests above user mappings) instead
+ * of failing on a VA limit that does not apply here.
+ */
+#if defined(SWEET_FAMILY)
+static_assert((_COMM_PAGE64_BASE_ADDRESS & ~ARM_TT_L1_OFFMASK) >=
+    ((mach_vm_offset_t)0x0000000FC0000000ULL));
+#else
 static_assert((_COMM_PAGE64_BASE_ADDRESS & ~ARM_TT_L1_OFFMASK) >= MACH_VM_MAX_ADDRESS);
+#endif
 #else
 #error Nested shared page mapping is unsupported on this config
 #endif
