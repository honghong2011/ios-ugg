diff --git a/pexpert/pexpert/arm64/UGG.h b/pexpert/pexpert/arm64/UGG.h
new file mode 100644
index 0000000..9552bd1
--- /dev/null
+++ b/pexpert/pexpert/arm64/UGG.h
@@ -0,0 +1,99 @@
+/*
+ * Board config for the Redmi Note 5A Prime ("ugg", Qualcomm MSM8940 /
+ * Snapdragon 435 + PMI8937): 8x Cortex-A53 in two clusters
+ * (MPIDR 0x0-3 @1.4 GHz, 0x100-103 @1.1 GHz), ARMv8.0, no PAC, no 16K granule.
+ *
+ * ugg is the 8-core big brother of the 4-core MSM8917: same A53s, same
+ * GIC-400 (qcom,msm-qgic2), same 4K/64K-only translation granules
+ * (measured on the device: ID_AA64MMFR0_EL1 = 0x1122, TGran16 = 0), same
+ * splash panel family.
+ *
+ *  1. __ARM_16K_PG__ is NOT defined, so ARM_PGSHIFT stays 12.
+ *
+ *  2. The iOS 16 userspace is built for 16K pages. That still works: on a
+ *     non-16K build with more than 1 GiB of RAM, arm_init() selects
+ *     PAGE_SHIFT_CONST = PAGE_MAX_SHIFT (14), so the VM page size is 16K
+ *     while the hardware granule is 4K. PAGE_RATIO is then 4 and the pmap
+ *     writes four 4K PTEs per 16K VM page - the A7/A8 arrangement. ugg has
+ *     4 GB, so this branch is taken automatically.
+ *
+ * The interrupt controller is GICv2 (qcom,msm-qgic2), not GICv3: no
+ * redistributors, and the CPU interface is a second MMIO frame
+ * (GICD 0x0b000000, GICC 0x0b002000). Everything is still taken as a
+ * Group 1 IRQ through the same sleh_irq() path, because Qualcomm's GIC
+ * has two security states and TrustZone owns Group 0.
+ */
+
+#ifndef _PEXPERT_ARM64_UGG_H
+#define _PEXPERT_ARM64_UGG_H
+
+#define NO_MONITOR                1
+#define NO_ECORE                  1
+
+#define UGG                       1
+#define SWEET                     1     /* shares the SWEET driver code paths */
+#define UGG_GIC_V2                1     /* selects the GICv2 implementation */
+
+/*
+ * Eight homogeneous A53s in two MPIDR clusters; the boot CPU may be in
+ * either cluster (measured: 0x100). SWEET's own limit lives in SWEET.h,
+ * which this build does not include, so the clamp is defined here.
+ */
+#define SWEET_SMP_MAX_CPUS        8
+
+#define ARM_ARCH_TIMER
+#define __ARM_ARCH__              8
+#define __ARM_VMSA__              8
+#define __ARM_VFP__               4
+#define __ARM_COHERENT_CACHE__    1
+#define __ARM_DEBUG__             7
+#define __ARM_ENABLE_SWAP__       1
+
+/*
+ * Cortex-A53 is ARMv8.0. Do NOT set __ARM_PAN_AVAILABLE__ (PAN is ARMv8.1),
+ * __ARM_V8_CRYPTO_EXTENSIONS__ (optional on A53, and the boot CPU must be
+ * checked before relying on it) or __ARM_16K_PG__ (no such granule).
+ *
+ * __ARM64_PMAP_SUBPAGE_L1__ matches the BCM2837 (4K-granule) config and lets
+ * the pmap use level-1 subpages, which a 4K root table needs for the VM
+ * region sizes this kernel uses.
+ */
+#define __ARM64_PMAP_SUBPAGE_L1__ 1
+
+/*
+ * Qualcomm numbers the architected timer PPIs 2/3/4/1 (secure phys, phys,
+ * virt, hyp) on the 8937 family, so the virtual timer XNU uses (CNTV) is
+ * INTID 16 + 4 = 20. Verified against the live device tree on the phone and
+ * by the U1 shim probe (30 interrupts in 300 ms on INTID 20, none other).
+ */
+#define SWEET_VTIMER_INTID        20
+#define SWEET_IPI_SGI             1       /* SGI used for cross-CPU signals */
+
+#define GIC_SPURIOUS_IRQ          1023    /* IRQ no. for GIC spurious interrupt */
+
+/* GICv2 register definitions; see the GICv2 architecture spec (IHI 0048B). */
+#define GICD_CTLR                 0x000
+#define GICD_TYPER                0x004
+#define GICD_IGROUPR              0x080
+#define GICD_ISENABLER            0x100
+#define GICD_IPRIORITYR           0x400
+#define GICD_ICFGR                0xc00
+#define GICD_SGIR                 0xf00
+
+#define GICC_CTLR                 0x000
+#define GICC_PMR                  0x004
+#define GICC_BPR                  0x008
+#define GICC_IAR                  0x00c
+#define GICC_EOIR                 0x010
+
+#define GICD_CTLR_ENABLE          0x1
+#define GICD_CTLR_RWP             0x80000000
+
+/* Still needed on GICv2: the Group 1 enable is an ICC_* system register. */
+#define ICC_SRE_SRE               0x1
+
+#ifndef ASSEMBLER
+#define PLATFORM_PANIC_LOG_DISABLED
+#endif /* ! ASSEMBLER */
+
+#endif /* ! _PEXPERT_ARM64_UGG_H */
diff --git a/pexpert/pexpert/arm64/board_config.h b/pexpert/pexpert/arm64/board_config.h
index 88e524a..87a2f1c 100644
--- a/pexpert/pexpert/arm64/board_config.h
+++ b/pexpert/pexpert/arm64/board_config.h
@@ -108,6 +108,28 @@
 
 #endif  /* ARM64_BOARD_CONFIG_SWEET */
 
+/*
+ * The ugg/sweet board family: both are Qualcomm phones driven by the
+ * sweet drivers (framebuffer console, PSCI SMP, GIC ack/eoi accessors).
+ * 20+ translation units test this macro without including board_config.h,
+ * so the build also passes -DSWEET_FAMILY in MACHINE_FLAGS; the definition
+ * here is the redundant fallback for the ones that do include it.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_UGG)
+#define SWEET_FAMILY 1
+#endif
+
+#ifdef ARM64_BOARD_CONFIG_UGG
+#include <pexpert/arm64/UGG.h>
+
+#define MAX_L2_CLINE                   6
+#define MAX_CPUS                       8 /* 2x4 Cortex-A53 clusters */
+#define MAX_CPU_CLUSTERS               1
+
+#define CORE_NCTRS                     8 /* Placeholder; KPC is not enabled for this target */
+
+#endif  /* ARM64_BOARD_CONFIG_UGG */
+
 #ifdef ARM64_BOARD_CONFIG_VMAPPLE
 #include <pexpert/arm64/VMAPPLE.h>
 
