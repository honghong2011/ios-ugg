+/*
+ * Descend from the root of the kernel's page tables to the L2 table covering
+ * va, which is where the L3 (PTE) tables are hooked in.
+ *
+ * The root is L0 on a 48-bit-VA configuration (ugg: T0SZ=T1SZ=16) and L1 on
+ * every other configuration, so the number of levels between cpu_tte and the
+ * L2 differs by one. Callers are responsible for the tables along the path
+ * already existing.
+ */
+static tt_entry_t *
+arm_kva_to_l2_table(vm_offset_t va)
+{
+	tt_entry_t *tte = cpu_tte + ((va & ARM_TT_ROOT_INDEX_MASK) >> ARM_TT_ROOT_SHIFT);
+
+#if ARM_TT_ROOT_LEVEL == 0
+	tte = L1_TABLE_VA(tte) + L1_TABLE_INDEX(va);
+#endif
+	return L2_TABLE_VA(tte);
+}
+
 tt_entry_t *
 arm_kva_to_tte(vm_offset_t va)
 {
+#if ARM_TT_ROOT_LEVEL == 0
+	/*
+	 * 48-bit VA (ugg): root(L0) -> L1 -> L2. Indexing cpu_tte with the L1
+	 * bits instead would leave the entry the hardware walk actually reads
+	 * (index VA[47:39], 0x1fc for the kernel) unmapped, and the next fetch
+	 * after MSR SCTLR_EL1 would take a level-0 translation fault.
+	 */
+	return arm_kva_to_l2_table(va) + L2_TABLE_INDEX(va);
+#else
 	tt_entry_t *tte1, *tte2;
 	tte1 = cpu_tte + L1_TABLE_INDEX(va);
 	tte2 = L2_TABLE_VA(tte1) + L2_TABLE_INDEX(va);
 
 	return tte2;
+#endif
 }
 
