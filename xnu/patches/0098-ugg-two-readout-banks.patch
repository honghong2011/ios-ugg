diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -29,22 +29,30 @@
 #define EARLY_ROWS ((EARLY_HEIGHT - 32u) / EARLY_CELL_H)
 #define EARLY_COLS (EARLY_WIDTH / EARLY_CELL_W)
 /*
- * Screen layout, from the top:
- *
- *   rows 0 .. EARLY_TEXT_ROWS-1     scrolling console
- *   rows EARLY_VAL_ROW .. +9        fixed boot readout (see sweet_early_val)
- *   row  EARLY_ROWS - 1             stack gauge
- *
- * Rows are reserved, not merely written once. The first gauge attempt shared
- * its row with the console and was overwritten; the first readout attempt was
- * painted inside the scrolling area and the ~27-row panic dump then scrolled
- * straight over it, so a boot that had the numbers in the binary showed none
- * of them. The console is capped at 28 rows because the dump needs about that
- * many, and everything from EARLY_VAL_ROW up is never touched by scrolling.
- */
-#define EARLY_TEXT_ROWS 28u
-#define EARLY_VAL_ROW   (EARLY_ROWS - 11u)
-#define EARLY_GAUGE_ROW (EARLY_ROWS - 1u)
+ * Screen layout, from the top (EARLY_ROWS is 39 on this panel):
+ *
+ *   rows  0 .. 17   scrolling console
+ *   rows 18 .. 27   readout bank A  (slots 0..9,  painted early)
+ *   rows 28 .. 37   readout bank B  (slots 10..19, painted later)
+ *   row  38         stack gauge
+ *
+ * Two banks exist because two independent components report numbers at
+ * different times: arm_vm_init paints the ptov_table before pmap_bootstrap()
+ * runs, and pmap_data_bootstrap() paints the pmap numbers afterwards. The
+ * first version gave both the same ten slots, so the later paint silently
+ * overwrote the earlier one and the panel showed only the second set - the
+ * ptov values were in the kernel, were printed, and were then erased.
+ *
+ * Rows are reserved, never merely written once. Earlier rounds proved this the
+ * hard way twice: the gauge shared a row with the console and was overwritten,
+ * and the readout first sat inside the scrolling area, where the ~27-row panic
+ * dump scrolled it away. The console is capped at 18 rows; nothing at or below
+ * row 18 is ever touched by scrolling.
+ */
+#define EARLY_TEXT_ROWS 18u
+#define EARLY_VAL_ROW_A (EARLY_ROWS - 21u)      /* 18 */
+#define EARLY_VAL_ROW_B (EARLY_ROWS - 11u)      /* 28 */
+#define EARLY_GAUGE_ROW (EARLY_ROWS - 1u)       /* 38 */
 /*
  * Leave the first character cell blank. The phone's active area starts at the
  * panel edge, so text drawn in column 0 is cut in half by the bezel; the 0090
@@ -349,8 +357,12 @@
  * it and it costs no rows from the console. Slots start below the last stage
  * marker row and are ordered so the most important value is highest.
  */
-#define SWEET_VAL_SLOT_MAX   10u
-
+#define SWEET_VAL_SLOT_MAX   20u
+
+/*
+ * Slots 0..9 go to bank A (painted first), 10..19 to bank B (painted later).
+ * The split keeps the two reporters from overwriting each other.
+ */
 void
 sweet_early_val(unsigned int slot, const char *tag, uint64_t value)
 {
@@ -358,7 +370,8 @@
 		return;
 	}
 
-	unsigned int row = EARLY_VAL_ROW + slot;
+	unsigned int row = (slot < 10u) ? (EARLY_VAL_ROW_A + slot)
+	                                : (EARLY_VAL_ROW_B + slot - 10u);
 	unsigned int col = EARLY_LEFT_MARGIN;
 
 	while (*tag && col < EARLY_TEXT_COLS) {
@@ -443,133 +456,3 @@
 	__asm__ volatile("dsb sy" ::: "memory");
 }
 #endif /* SWEET */
-/*
- * Redmi Note 10 Pro bootstrap console. No allocation, locks, ADT parsing or
- * per-CPU state: panic() can reach this before a current thread exists.
- * start.s maps the splash framebuffer VA=PA as Normal Non-Cacheable memory.
- * Stop using that mapping before arm_vm_init tears down bootstrap TTBR0.
- */
-#include <arm64/sweet_early.h>
-
-#if defined(SWEET)
-#include <stdint.h>
-#include <kern/misc_protos.h>
-
-#define EARLY_FB ((volatile uint32_t *)(uintptr_t)0x9c000000)
-#define EARLY_WIDTH 1080u
-#define EARLY_HEIGHT 2400u
-#define EARLY_STRIDE (4320u / 4)
-#define EARLY_SCALE 2u
-#define EARLY_CELL_W (8u * EARLY_SCALE)
-#define EARLY_CELL_H (16u * EARLY_SCALE)
-#define EARLY_ROWS ((EARLY_HEIGHT - 32u) / EARLY_CELL_H)
-#define EARLY_COLS (EARLY_WIDTH / EARLY_CELL_W)
-
-extern unsigned char iso_font[256 * 16];
-
-/* Initialized data must remain writable until disable, including panics. */
-static unsigned int early_row, early_col;
-static unsigned int early_started, early_disabled, early_panicking;
-
-static void
-sweet_early_clear_row(void)
-{
-	for (unsigned int y = 0; y < EARLY_CELL_H; y++) {
-		volatile uint32_t *line = EARLY_FB + (early_row * EARLY_CELL_H + y) * EARLY_STRIDE;
-		for (unsigned int x = 0; x < EARLY_WIDTH; x++) {
-			line[x] = 0xff000000u;
-		}
-	}
-}
-
-void
-sweet_early_putc(char c)
-{
-	if (early_disabled) {
-		return;
-	}
-	if (!early_started) {
-		early_started = 1;
-		sweet_early_clear_row();
-	}
-	if (c == '\r') {
-		early_col = 0;
-		return;
-	}
-	if (c == '\n' || early_col == EARLY_COLS) {
-		early_col = 0;
-		early_row = (early_row + 1) % EARLY_ROWS;
-		sweet_early_clear_row();
-		if (c == '\n') {
-			return;
-		}
-	}
-	const unsigned char *glyph = iso_font + (unsigned char)c * 16;
-	for (unsigned int gy = 0; gy < 16; gy++) {
-		for (unsigned int sy = 0; sy < EARLY_SCALE; sy++) {
-			volatile uint32_t *line = EARLY_FB +
-			    (early_row * EARLY_CELL_H + gy * EARLY_SCALE + sy) * EARLY_STRIDE +
-			    early_col * EARLY_CELL_W;
-			for (unsigned int gx = 0; gx < 8; gx++) {
-				uint32_t pixel = (glyph[gy] & (1u << gx)) ? 0xffffffffu : 0xff000000u;
-				for (unsigned int sx = 0; sx < EARLY_SCALE; sx++) {
-					line[gx * EARLY_SCALE + sx] = pixel;
-				}
-			}
-		}
-	}
-	early_col++;
-}
-
-static void
-sweet_early_string(const char *s)
-{
-	while (*s) {
-		sweet_early_putc(*s++);
-	}
-}
-
-void
-sweet_early_mark(unsigned int stage, const char *label)
-{
-	if (early_disabled || stage > 8) {
-		return;
-	}
-	uint32_t color = 0xff00ff00u | (stage * 28u << 16);
-	for (unsigned int y = EARLY_HEIGHT - 32; y < EARLY_HEIGHT; y++) {
-		for (unsigned int x = stage * 64; x < (stage + 1) * 64; x++) {
-			EARLY_FB[y * EARLY_STRIDE + x] = color;
-		}
-	}
-	__asm__ volatile("dsb sy" ::: "memory");
-	sweet_early_string("SWEET EARLY ");
-	sweet_early_putc((char)('0' + stage));
-	sweet_early_string(": ");
-	sweet_early_string(label);
-	sweet_early_putc('\n');
-}
-
-void
-sweet_early_panic(const char *fmt, va_list *args)
-{
-	if (early_disabled || early_panicking) {
-		return;
-	}
-	early_panicking = 1;
-	sweet_early_string("\nSWEET EARLY PANIC: ");
-	va_list copy;
-	va_copy(copy, *args);
-	_doprnt(fmt, &copy, sweet_early_putc, 16);
-	va_end(copy);
-	sweet_early_putc('\n');
-	__asm__ volatile("dsb sy" ::: "memory");
-}
-
-void
-sweet_early_disable(void)
-{
-	sweet_early_mark(8, "leaving bootstrap TTBR0");
-	early_disabled = 1;
-	__asm__ volatile("dsb sy" ::: "memory");
-}
-#endif /* SWEET */
diff --git a/osfmk/arm/pmap/pmap_data.c b/osfmk/arm/pmap/pmap_data.c
