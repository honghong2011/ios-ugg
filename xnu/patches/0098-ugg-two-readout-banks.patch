@@ -712,16 +712,22 @@
 		extern unsigned long real_phys_size;
 		extern vm_map_address_t physmap_base, physmap_end;
 
-		sweet_early_val(0, "zerva", (uint64_t)phystokv(pmap_struct_start));
-		sweet_early_val(1, "zerolastva", (uint64_t)(phystokv(pmap_struct_start) + (avail_start - pmap_struct_start) - 1));
-		sweet_early_val(2, "physmapbase", (uint64_t)physmap_base);
-		sweet_early_val(3, "physmapend", (uint64_t)physmap_end);
-		sweet_early_val(4, "zerolen", (uint64_t)(avail_start - pmap_struct_start));
-		sweet_early_val(5, "mem_size", (uint64_t)mem_size);
-		sweet_early_val(6, "realphys", (uint64_t)real_phys_size);
-		sweet_early_val(7, "pmapstart", (uint64_t)pmap_struct_start);
-		sweet_early_val(8, "availstart", (uint64_t)avail_start);
-		sweet_early_val(9, "gphysbase", (uint64_t)gPhysBase);
+		/*
+		 * Bank B (slots 10..19). arm_vm_init already painted the ptov
+		 * numbers into bank A before pmap_bootstrap() reached us; using the
+		 * same slots here silently erased them, which is why 0097's ptov
+		 * output never appeared even though the strings were in the kernel.
+		 */
+		sweet_early_val(10, "zerva", (uint64_t)phystokv(pmap_struct_start));
+		sweet_early_val(11, "zerolastva", (uint64_t)(phystokv(pmap_struct_start) + (avail_start - pmap_struct_start) - 1));
+		sweet_early_val(12, "physmapbase", (uint64_t)physmap_base);
+		sweet_early_val(13, "physmapend", (uint64_t)physmap_end);
+		sweet_early_val(14, "zerolen", (uint64_t)(avail_start - pmap_struct_start));
+		sweet_early_val(15, "mem_size", (uint64_t)mem_size);
+		sweet_early_val(16, "realphys", (uint64_t)real_phys_size);
+		sweet_early_val(17, "pmapstart", (uint64_t)pmap_struct_start);
+		sweet_early_val(18, "availstart", (uint64_t)avail_start);
+		sweet_early_val(19, "gphysbase", (uint64_t)gPhysBase);
 	}
 #endif /* SWEET_FAMILY */
 
