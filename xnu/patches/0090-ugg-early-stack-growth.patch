diff --git a/osfmk/mach/arm/vm_param.h b/osfmk/mach/arm/vm_param.h
index c013288..b7c2a15 100644
--- a/osfmk/mach/arm/vm_param.h
+++ b/osfmk/mach/arm/vm_param.h
@@ -327,10 +327,42 @@ extern uint64_t                 gDramBase, gDramSize;
 # define KERNEL_STACK_SIZE      (4*4096*KERNEL_STACK_MULTIPLIER)
 #endif /* XNU_KERNEL_PRIVATE */
 
-#define INTSTACK_SIZE           (4*4096)
+/*
+ * Boot interrupt and exception stacks.
+ *
+ * KERNEL_STACK_SIZE above scales with KASAN and DEBUG because an instrumented
+ * or -O0 compiler needs more stack per frame. INTSTACK_SIZE had no equivalent
+ * scaling, so a DEVELOPMENT/DEBUG kernel runs its longest early chain - the
+ * arm_init -> arm_vm_init -> pmap_bootstrap path and the ADT walk - on the
+ * same 16 KiB a RELEASE kernel uses. Synchronous EL1 exceptions share it too:
+ * the EL1_SP0 vector reserves ARM_CONTEXT_SIZE (848) bytes before any C runs.
+ *
+ * On UGG that overflows. The phone faulted with FAR 0xfffffe00080abfd0 and
+ * ESR 0x9600004f (data abort, write, permission fault level 3). The saved
+ * state reports sp 0xfffffe00080abf50, which is the ARM_CONTEXT frame base as
+ * CHECK_KERNEL_STACK stores it (after its own sub sp, sp, #ARM_CONTEXT_SIZE),
+ * and far - sp is exactly 0x80, the offset of fleh_dispatch64's first stp.
+ * So SP_EL0 was 0xfffffe00080ac2a0 when the exception was taken: only 672
+ * bytes of the stack were still free, and framing the exception needed 848,
+ * leaving the frame 176 bytes past the bottom of intstack, inside the 16 KiB
+ * low guard page that arm_vm_init() maps read-only and no-execute. That is
+ * 95.9% of the stack already consumed before any fault was handled.
+ * CHECK_KERNEL_STACK then ran, found SP_EL0 below the stack, and panicked
+ * correctly: the guard page turned a silent stack smash into a reported
+ * fault, at the cost of stopping the boot. Give UGG a 4x early stack; these
+ * are per CPU and the memory is negligible on a 4 GiB device. The assembly
+ * checks read INTSTACK_SIZE_NUM from genassym, so they follow this constant.
+ */
+#if defined(BOARD_UGG) || defined(BOARD_UGGLITE)
+#define INTSTACK_SCALE          (4)
+#else
+#define INTSTACK_SCALE          (1)
+#endif
+
+#define INTSTACK_SIZE           (4*4096*INTSTACK_SCALE)
 
 #ifdef __arm64__
-#define EXCEPSTACK_SIZE         (4*4096)
+#define EXCEPSTACK_SIZE         (4*4096*INTSTACK_SCALE)
 #else
 #define FIQSTACK_SIZE           (4096)
 #endif
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -58,6 +58,85 @@
 
 extern unsigned char iso_font[256 * 16];
 
+/*
+ * Boot stack bounds from __BOOTDATA (osfmk/arm/data.s). arm_init() runs on
+ * SP_EL0 == &intstack_top and every synchronous exception taken from SP_EL0 is
+ * framed on that same stack, so these turn a raw SP reading into "how much of
+ * the boot stack this chain has already consumed".
+ */
+extern uint8_t intstack[];
+extern uint8_t intstack_top[];
+
+static void sweet_early_glyph(unsigned int col, unsigned int row, char c);
+static void sweet_early_vprint(const char *fmt, ...);
+
+static uintptr_t
+sweet_early_sp_el0(void)
+{
+	uintptr_t el0;
+
+	__asm__ volatile("mrs %0, SP_EL0" : "=r"(el0));
+	return el0;
+}
+
+/* Bytes of boot interrupt stack still unused below SP_EL0. */
+static uintptr_t
+sweet_early_stackfree(void)
+{
+	uintptr_t el0 = sweet_early_sp_el0();
+	uintptr_t base = (uintptr_t)intstack, top = (uintptr_t)intstack_top;
+
+	if (el0 < base || el0 > top) {
+		return 0;               /* off the boot stack: thread stack later on */
+	}
+	return el0 - base;
+}
+
+/*
+ * Boot-stack gauge, painted at a FIXED character cell (last row, column 0).
+ *
+ * Appending the value to each stage label was the obvious approach and it is
+ * wrong on this panel: the console is 45 columns wide and appending " stkXXXX"
+ * pushes 11 of the 20 stage lines onto a second row, so the 39-row ring starts
+ * scrolling and the earliest markers disappear exactly when they are needed.
+ * A fixed cell never scrolls and never costs a row, so the ladder and the gauge
+ * are both intact. Painted only when the stack is still the boot stack.
+ */
+static void
+sweet_early_stackgauge(void)
+{
+	static const char label[] = "stk";
+	uintptr_t free_bytes = sweet_early_stackfree();
+
+	if (free_bytes == 0) {
+		return;         /* on a thread stack now: not our business */
+	}
+	for (unsigned int i = 0; i < 4; i++) {
+		sweet_early_glyph(i, EARLY_ROWS - 1, label[i]);
+	}
+	/* 18 free bytes per unit, drawn as 4 hex digits: "stk0400" == 16 KiB. */
+	unsigned int units = (unsigned int)(free_bytes / 18u);
+	static const char digits[] = "0123456789abcdef";
+	for (unsigned int i = 0; i < 4; i++) {
+		sweet_early_glyph(4 + i, EARLY_ROWS - 1,
+		    digits[(units >> (12 - 4 * i)) & 0xf]);
+	}
+}
+
+/*
+ * Full reading, for the fault report only: a whole line is affordable once,
+ * because nothing follows it.
+ */
+static void
+sweet_early_stackinfo(void)
+{
+	sweet_early_vprint("  el0 %016llx ibase %016llx itop %016llx free %016llx\n",
+	    (unsigned long long)sweet_early_sp_el0(),
+	    (unsigned long long)(uintptr_t)intstack,
+	    (unsigned long long)(uintptr_t)intstack_top,
+	    (unsigned long long)sweet_early_stackfree());
+}
+
 /* Initialized data must remain writable until disable, including panics. */
 static unsigned int early_row, early_col;
 static unsigned int early_started, early_disabled, early_panicking;
@@ -69,6 +148,31 @@
 		volatile uint8_t *line = EARLY_FB + (early_row * EARLY_CELL_H + y) * EARLY_STRIDE;
 		for (unsigned int x = 0; x < EARLY_WIDTH; x++) {
 			sweet_early_pixel(line, x, 0xff000000u);
+		}
+	}
+}
+
+/*
+ * Draw one iso_font glyph at an absolute character cell. Split out of
+ * sweet_early_putc() so the stack gauge can be painted at a fixed cell instead
+ * of advancing the scrolling cursor.
+ */
+static void
+sweet_early_glyph(unsigned int col, unsigned int row, char c)
+{
+	const unsigned char *glyph = iso_font + (unsigned char)c * 16;
+
+	for (unsigned int gy = 0; gy < 16; gy++) {
+		for (unsigned int sy = 0; sy < EARLY_SCALE; sy++) {
+			volatile uint8_t *line = EARLY_FB +
+			    (row * EARLY_CELL_H + gy * EARLY_SCALE + sy) * EARLY_STRIDE;
+			for (unsigned int gx = 0; gx < 8; gx++) {
+				uint32_t pixel = (glyph[gy] & (1u << gx)) ? 0xffffffffu : 0xff000000u;
+				for (unsigned int sx = 0; sx < EARLY_SCALE; sx++) {
+					sweet_early_pixel(line, col * EARLY_CELL_W +
+					    gx * EARLY_SCALE + sx, pixel);
+				}
+			}
 		}
 	}
 }
@@ -107,20 +211,7 @@
 			return;
 		}
 	}
-	const unsigned char *glyph = iso_font + (unsigned char)c * 16;
-	for (unsigned int gy = 0; gy < 16; gy++) {
-		for (unsigned int sy = 0; sy < EARLY_SCALE; sy++) {
-			volatile uint8_t *line = EARLY_FB +
-			    (early_row * EARLY_CELL_H + gy * EARLY_SCALE + sy) * EARLY_STRIDE;
-			for (unsigned int gx = 0; gx < 8; gx++) {
-				uint32_t pixel = (glyph[gy] & (1u << gx)) ? 0xffffffffu : 0xff000000u;
-				for (unsigned int sx = 0; sx < EARLY_SCALE; sx++) {
-					sweet_early_pixel(line, early_col * EARLY_CELL_W +
-					    gx * EARLY_SCALE + sx, pixel);
-				}
-			}
-		}
-	}
+	sweet_early_glyph(early_col, early_row, c);
 	early_col++;
 }
 
@@ -157,6 +248,7 @@
 	sweet_early_string(": ");
 	sweet_early_string(label);
 	sweet_early_putc('\n');
+	sweet_early_stackgauge();
 }
 
 static void
@@ -190,6 +282,8 @@
 	    "\n sp %016llx  esr %08x  far %016llx\n",
 	    (unsigned long long)pc, (unsigned long long)lr,
 	    (unsigned long long)sp, (unsigned int)esr, (unsigned long long)far);
+	sweet_early_string(" istack:");
+	sweet_early_stackinfo();
 	__asm__ volatile("dsb sy" ::: "memory");
 }
 
